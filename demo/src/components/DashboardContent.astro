---
import Card from './Card.astro';
import StatusBadge from './StatusBadge.astro';
import data from '../data/data.json';
import { calculateTotalMonthlyCost } from '../lib/pricing.js';

const totalMonthlyCost = calculateTotalMonthlyCost(data.data, data.pricing, data.presets);

const stats = {
  vms: data.data.vms?.length || 0,
  dbInstances: data.data.dbInstances?.length || 0,
  kubernetes: data.data.kubernetes?.length || 0,
  monthlyCost: totalMonthlyCost,
};

const recentActivity = data.data.auditLog?.slice(0, 10) || [];
const notifications = data.data.notifications || [];
const dashboardConfig = data.pages['/dashboard'];
---

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  {dashboardConfig.cards.map(card => {
    let value = stats[card.key];
    if (card.key === 'monthlyEstimate') {
      value = `${stats.monthlyCost}`;
    }
    return (
      <Card title={card.label} value={value} icon={card.icon} />
    );
  })}
</div>

<!-- Two Column Layout -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  <!-- Cost Trend Chart -->
  <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
    <h3 class="text-lg font-semibold mb-4">{dashboardConfig.charts.costTrend.title}</h3>
    <div class="h-48 flex items-end gap-2">
      {dashboardConfig.charts.costTrend.series.map((value, index) => {
        const maxValue = Math.max(...dashboardConfig.charts.costTrend.series);
        const height = (value / maxValue) * 100;
        return (
          <div class="flex-1 bg-primary rounded-t" style={`height: ${height}%`} title={`${value} EUR`}></div>
        );
      })}
    </div>
    <div class="flex justify-between text-xs text-gray-500 mt-2">
      <span>7 days ago</span>
      <span>Today</span>
    </div>
  </div>

  <!-- System Health -->
  <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
    <h3 class="text-lg font-semibold mb-4">{dashboardConfig.health.title}</h3>
    <div class="space-y-3">
      {dashboardConfig.health.items.map(item => (
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-gray-700">{item.label}</span>
          <StatusBadge status={item.status} />
        </div>
      ))}
    </div>
  </div>
</div>

<!-- Capacity Utilization -->
<div class="bg-white rounded-lg shadow p-6 border border-gray-200 mb-8">
  <h3 class="text-lg font-semibold mb-4">{dashboardConfig.charts.capacity.title}</h3>
  <div class="space-y-4">
    <div>
      <div class="flex justify-between text-sm mb-1">
        <span class="font-medium text-gray-700">CPU</span>
        <span class="text-gray-600">{dashboardConfig.charts.capacity.cpuPercent}%</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2">
        <div class="bg-primary h-2 rounded-full" style={`width: ${dashboardConfig.charts.capacity.cpuPercent}%`}></div>
      </div>
    </div>
    <div>
      <div class="flex justify-between text-sm mb-1">
        <span class="font-medium text-gray-700">RAM</span>
        <span class="text-gray-600">{dashboardConfig.charts.capacity.ramPercent}%</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2">
        <div class="bg-accent h-2 rounded-full" style={`width: ${dashboardConfig.charts.capacity.ramPercent}%`}></div>
      </div>
    </div>
    <div>
      <div class="flex justify-between text-sm mb-1">
        <span class="font-medium text-gray-700">Storage</span>
        <span class="text-gray-600">{dashboardConfig.charts.capacity.storagePercent}%</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2">
        <div class="bg-warning h-2 rounded-full" style={`width: ${dashboardConfig.charts.capacity.storagePercent}%`}></div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Activity -->
<div class="bg-white rounded-lg shadow border border-gray-200">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold">{dashboardConfig.recentActivity.title}</h3>
  </div>
  <div class="divide-y divide-gray-200">
    {recentActivity.map(event => (
      <div class="px-6 py-4 hover:bg-gray-50">
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <p class="text-sm font-medium text-gray-900">
              {event.action}
            </p>
            <p class="text-sm text-gray-600 mt-1">
              by {event.actor} on {event.target}
            </p>
          </div>
          <div class="flex items-center gap-3">
            <StatusBadge status={event.result} />
            <span class="text-xs text-gray-500">{new Date(event.when).toLocaleString()}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<!-- Notifications Panel (floating) -->
{notifications.length > 0 && (
  <div class="fixed bottom-4 right-4 w-96 max-h-96 overflow-y-auto bg-white rounded-lg shadow-lg border border-gray-200 hidden" id="notifications-panel">
    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
      <h4 class="font-semibold">Notifications</h4>
      <button class="text-gray-400 hover:text-gray-600" onclick="document.getElementById('notifications-panel').classList.add('hidden')">✕</button>
    </div>
    <div class="divide-y divide-gray-200">
      {notifications.map(notif => (
        <div class={`px-4 py-3 ${notif.level === 'warning' ? 'bg-yellow-50' : notif.level === 'error' ? 'bg-red-50' : 'bg-blue-50'}`}>
          <p class="text-sm font-medium">{notif.title}</p>
          <p class="text-xs text-gray-600 mt-1">{notif.message}</p>
          <p class="text-xs text-gray-500 mt-1">{new Date(notif.time).toLocaleString()}</p>
        </div>
      ))}
    </div>
  </div>
)}
