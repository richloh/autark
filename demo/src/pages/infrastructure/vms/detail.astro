---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import TagBadge from '../../../components/TagBadge.astro';

// This is a generic page that will load VM data on the client side based on ?id= parameter
---

<AutarkLayout
  title="Virtual Machine"
  description="VM details"
  currentPath="/infrastructure/vms"
>
  <div id="vm-loading" class="text-center py-12">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
    <p class="mt-4 text-gray-600">Loading VM details...</p>
  </div>

  <div id="vm-content" class="hidden">
    <!-- Action Bar -->
    <div class="mb-6 flex items-center justify-between">
      <a href="/infrastructure/vms" class="text-sm text-primary hover:underline">
        ← Back to VMs
      </a>
      <div class="flex gap-2" id="vm-actions">
        <!-- Actions will be inserted here -->
      </div>
    </div>

    <!-- Overview -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-sm font-medium text-gray-500 mb-3">Status & Specs</h3>
        <div class="space-y-3" id="vm-specs">
          <!-- Specs will be inserted here -->
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-sm font-medium text-gray-500 mb-3">Network & Location</h3>
        <div class="space-y-3" id="vm-network">
          <!-- Network info will be inserted here -->
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-sm font-medium text-gray-500 mb-3">Cost & Backup</h3>
        <div class="space-y-3" id="vm-cost">
          <!-- Cost info will be inserted here -->
        </div>
      </div>
    </div>

    <!-- Metrics -->
    <div class="bg-white rounded-lg shadow p-6 border border-gray-200 mb-6">
      <h3 class="text-lg font-semibold mb-4">Performance Metrics (Last 24 Hours)</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="vm-metrics">
        <!-- Metrics will be inserted here -->
      </div>
    </div>

    <!-- Networking Tab -->
    <div class="bg-white rounded-lg shadow border border-gray-200 mb-6">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold">Networking</h3>
      </div>
      <div class="p-6">
        <h4 class="text-sm font-medium text-gray-700 mb-3">Public IP Addresses</h4>
        <div id="vm-ips">
          <!-- IPs will be inserted here -->
        </div>
      </div>
    </div>

    <!-- Storage Tab -->
    <div class="bg-white rounded-lg shadow border border-gray-200 mb-6">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold">Attached Volumes</h3>
      </div>
      <div class="p-6">
        <div id="vm-volumes">
          <!-- Volumes will be inserted here -->
        </div>
      </div>
    </div>

    <!-- Security Tab -->
    <div class="bg-white rounded-lg shadow border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold">Security & Firewalls</h3>
      </div>
      <div class="p-6">
        <div id="vm-firewalls">
          <!-- Firewalls will be inserted here -->
        </div>

        <div class="mt-6">
          <h4 class="text-sm font-medium text-gray-700 mb-2">Tags</h4>
          <div class="flex flex-wrap gap-2" id="vm-tags">
            <!-- Tags will be inserted here -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="vm-error" class="hidden text-center py-12">
    <div class="text-danger text-4xl mb-4">⚠</div>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">VM Not Found</h3>
    <p class="text-gray-600 mb-4">The requested virtual machine could not be found.</p>
    <a href="/infrastructure/vms" class="text-primary hover:underline">← Back to Virtual Machines</a>
  </div>
</AutarkLayout>

<script>
  import dataJson from '../../../data/data.json';

  // Get VM ID from URL query parameter
  const urlParams = new URLSearchParams(window.location.search);
  const vmId = urlParams.get('id');

  // Helper functions
  function getStatusBadgeClass(status: string): string {
    const statusClasses: Record<string, string> = {
      running: 'bg-green-100 text-green-800',
      stopped: 'bg-gray-100 text-gray-800',
      provisioning: 'bg-yellow-100 text-yellow-800',
      error: 'bg-red-100 text-red-800'
    };
    return statusClasses[status] || statusClasses.stopped;
  }

  function calculateVMCost(vm: any, preset: any): number {
    const pricing = dataJson.pricing;
    let vcpus = 0, ramGB = 0, systemDiskGB = 0;

    if (preset) {
      vcpus = preset.vcpus;
      ramGB = preset.ramGB;
      systemDiskGB = preset.systemDiskGB;
    } else if (vm.custom) {
      vcpus = vm.custom.vcpus;
      ramGB = vm.custom.ramGB;
      systemDiskGB = vm.custom.systemDiskGB;
    }

    let cost = vcpus * pricing.vm.vCPUPerMonth;
    cost += ramGB * pricing.vm.ramGBPerMonth;
    cost += systemDiskGB * pricing.vm.systemDiskGBPerMonth;

    // Add GPU costs
    if (vm.gpus && vm.gpus.length > 0) {
      vm.gpus.forEach((gpu: any) => {
        const gpuHourly = pricing.vm.gpuPerHour[gpu.model] || 0;
        cost += gpu.count * gpuHourly * 24 * 30;
      });
    }

    // Add IP costs
    const ipCount = vm.ips?.length || 0;
    cost += ipCount * pricing.vm.publicIPv4PerMonth;

    return Math.round(cost * 100) / 100;
  }

  function renderMetricChart(values: number[], color: string, maxValue?: number): string {
    const max = maxValue || Math.max(...values);
    return values.map(value => {
      const height = max > 0 ? (value / max) * 100 : 0;
      return `<div class="flex-1 ${color} rounded-t" style="height: ${height}%" title="${value}"></div>`;
    }).join('');
  }

  // Load and render VM data
  function loadVMData() {
    if (!vmId) {
      document.getElementById('vm-loading')?.classList.add('hidden');
      document.getElementById('vm-error')?.classList.remove('hidden');
      return;
    }

    const vm = dataJson.data.vms.find((v: any) => v.id === vmId);

    if (!vm) {
      document.getElementById('vm-loading')?.classList.add('hidden');
      document.getElementById('vm-error')?.classList.remove('hidden');
      return;
    }

    const preset = vm.presetId ? dataJson.presets.vm.find((p: any) => p.id === vm.presetId) : null;
    const cost = calculateVMCost(vm, preset);

    // Get related data
    const vmIPs = vm.ips?.map((ipId: string) => dataJson.data.ips.find((i: any) => i.id === ipId)).filter(Boolean) || [];
    const vmVolumes = vm.attachedVolumes?.map((volId: string) => dataJson.data.volumes.find((v: any) => v.id === volId)).filter(Boolean) || [];
    const vmFirewalls = vm.firewallIds?.map((fwId: string) => dataJson.data.firewalls.find((f: any) => f.id === fwId)).filter(Boolean) || [];
    const network = dataJson.data.networks.find((n: any) => n.id === vm.network?.networkId);
    const subnet = network?.subnets.find((s: any) => s.id === vm.network?.subnetId);

    let vcpus, ramGB, systemDiskGB;
    if (preset) {
      vcpus = preset.vcpus;
      ramGB = preset.ramGB;
      systemDiskGB = preset.systemDiskGB;
    } else if (vm.custom) {
      vcpus = vm.custom.vcpus;
      ramGB = vm.custom.ramGB;
      systemDiskGB = vm.custom.systemDiskGB;
    }

    // Update page title
    document.title = `${vm.name} - Autark`;

    // Render actions
    const actionsHtml = vm.status === 'stopped'
      ? '<button class="px-4 py-2 bg-accent text-white rounded text-sm font-medium hover:bg-green-600">Start</button>'
      : '<button class="px-4 py-2 bg-gray-600 text-white rounded text-sm font-medium hover:bg-gray-700">Stop</button>';

    document.getElementById('vm-actions')!.innerHTML = `
      ${actionsHtml}
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">Reboot</button>
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">Create Backup</button>
      <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">Edit</button>
      <button class="px-4 py-2 bg-danger text-white rounded text-sm font-medium hover:bg-red-600">Delete</button>
    `;

    // Render specs
    const gpuHtml = vm.gpus && vm.gpus.length > 0
      ? `<div class="flex justify-between">
          <span class="text-sm text-gray-600">GPUs</span>
          <span class="text-sm font-medium">${vm.gpus.map((g: any) => `${g.count}x ${g.model}`).join(', ')}</span>
        </div>`
      : '';

    document.getElementById('vm-specs')!.innerHTML = `
      <div class="flex justify-between">
        <span class="text-sm text-gray-600">Status</span>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getStatusBadgeClass(vm.status)}">
          ${vm.status}
        </span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-gray-600">vCPUs</span>
        <span class="text-sm font-medium">${vcpus}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-gray-600">RAM</span>
        <span class="text-sm font-medium">${ramGB} GB</span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-gray-600">System Disk</span>
        <span class="text-sm font-medium">${systemDiskGB} GB</span>
      </div>
      ${gpuHtml}
    `;

    // Render network
    document.getElementById('vm-network')!.innerHTML = `
      <div class="flex justify-between">
        <span class="text-sm text-gray-600">Provider</span>
        <span class="text-sm font-medium">${vm.provider.type}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-gray-600">Network</span>
        <span class="text-sm font-medium">${network?.name || 'N/A'}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-gray-600">Subnet</span>
        <span class="text-sm font-medium">${subnet?.name || 'N/A'}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-gray-600">Public IPs</span>
        <span class="text-sm font-medium">${vmIPs.length}</span>
      </div>
    `;

    // Render cost
    const backupHtml = vm.backups?.enabled
      ? `<div class="flex justify-between">
          <span class="text-sm text-gray-600">Schedule</span>
          <span class="text-sm font-medium">${vm.backups.schedule}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Retention</span>
          <span class="text-sm font-medium">${vm.backups.retention} copies</span>
        </div>`
      : '';

    document.getElementById('vm-cost')!.innerHTML = `
      <div class="flex justify-between">
        <span class="text-sm text-gray-600">Monthly Cost</span>
        <span class="text-sm font-medium text-gray-900">€${cost}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-sm text-gray-600">Backups</span>
        <span class="text-sm font-medium">${vm.backups?.enabled ? 'Enabled' : 'Disabled'}</span>
      </div>
      ${backupHtml}
    `;

    // Render metrics
    const metrics = vm.metrics || {
      cpu: [10, 25, 30, 40, 20, 15, 35, 45],
      ram: [35, 38, 40, 45, 50, 48, 46, 44],
      diskIO: [10, 12, 30, 20, 25, 15, 18, 22],
      netIO: [2, 3, 5, 4, 3, 6, 4, 5]
    };

    document.getElementById('vm-metrics')!.innerHTML = `
      <div>
        <h4 class="text-sm font-medium text-gray-700 mb-2">CPU Usage (%)</h4>
        <div class="h-32 flex items-end gap-1">
          ${renderMetricChart(metrics.cpu, 'bg-primary', 100)}
        </div>
        <div class="mt-2 text-xs text-gray-500 text-center">Hourly samples</div>
      </div>
      <div>
        <h4 class="text-sm font-medium text-gray-700 mb-2">RAM Usage (%)</h4>
        <div class="h-32 flex items-end gap-1">
          ${renderMetricChart(metrics.ram, 'bg-accent', 100)}
        </div>
        <div class="mt-2 text-xs text-gray-500 text-center">Hourly samples</div>
      </div>
      <div>
        <h4 class="text-sm font-medium text-gray-700 mb-2">Disk I/O (MB/s)</h4>
        <div class="h-32 flex items-end gap-1">
          ${renderMetricChart(metrics.diskIO, 'bg-warning')}
        </div>
        <div class="mt-2 text-xs text-gray-500 text-center">Hourly samples</div>
      </div>
      <div>
        <h4 class="text-sm font-medium text-gray-700 mb-2">Network I/O (MB/s)</h4>
        <div class="h-32 flex items-end gap-1">
          ${renderMetricChart(metrics.netIO, 'bg-purple-500')}
        </div>
        <div class="mt-2 text-xs text-gray-500 text-center">Hourly samples</div>
      </div>
    `;

    // Render IPs
    if (vmIPs.length > 0) {
      document.getElementById('vm-ips')!.innerHTML = `
        <div class="space-y-2">
          ${vmIPs.map((ip: any) => `
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
              <div>
                <span class="font-mono text-sm font-medium">${ip.address}</span>
                <span class="ml-2 text-xs text-gray-500">IPv${ip.version}</span>
              </div>
              <div class="flex gap-1">
                ${ip.tags?.map((tag: any) => `
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                    ${tag.key}: ${tag.value}
                  </span>
                `).join('') || ''}
              </div>
            </div>
          `).join('')}
        </div>
      `;
    } else {
      document.getElementById('vm-ips')!.innerHTML = '<p class="text-sm text-gray-500">No public IPs assigned</p>';
    }

    // Render volumes
    if (vmVolumes.length > 0) {
      document.getElementById('vm-volumes')!.innerHTML = `
        <div class="space-y-3">
          ${vmVolumes.map((vol: any) => `
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded">
              <div>
                <a href="/infrastructure/volumes/detail?id=${vol.id}" class="text-sm font-medium text-primary hover:underline">
                  ${vol.name}
                </a>
                <div class="text-xs text-gray-500 mt-1">
                  ${vol.type.toUpperCase()} • ${vol.sizeGB} GB • ${vol.iops} IOPS
                </div>
              </div>
              <div class="text-sm font-medium">€${vol.monthlyCostHint}</div>
            </div>
          `).join('')}
        </div>
      `;
    } else {
      document.getElementById('vm-volumes')!.innerHTML = '<p class="text-sm text-gray-500">No volumes attached</p>';
    }

    // Render firewalls
    if (vmFirewalls.length > 0) {
      document.getElementById('vm-firewalls')!.innerHTML = `
        <div class="space-y-3">
          ${vmFirewalls.map((fw: any) => `
            <div class="p-4 bg-gray-50 rounded">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-900">${fw.name}</span>
                <span class="text-xs text-gray-500">${fw.rules.length} rules</span>
              </div>
              <div class="text-xs text-gray-600">
                Default policy: <span class="font-medium">${fw.defaultPolicy}</span>
              </div>
            </div>
          `).join('')}
        </div>
      `;
    } else {
      document.getElementById('vm-firewalls')!.innerHTML = '<p class="text-sm text-gray-500">No firewalls attached</p>';
    }

    // Render tags
    if (vm.tags && vm.tags.length > 0) {
      document.getElementById('vm-tags')!.innerHTML = vm.tags.map((tag: any) => `
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
          ${tag.key}: ${tag.value}
        </span>
      `).join('');
    } else {
      document.getElementById('vm-tags')!.innerHTML = '<p class="text-sm text-gray-500">No tags</p>';
    }

    // Show content
    document.getElementById('vm-loading')?.classList.add('hidden');
    document.getElementById('vm-content')?.classList.remove('hidden');
  }

  // Load data on page load
  loadVMData();
</script>
