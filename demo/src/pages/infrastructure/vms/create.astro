---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import data from '../../../data/data.json';

const presets = data.presets.vm || [];
const locations = data.hardwareProviders.selfHosted || [];
const cloudProviders = data.hardwareProviders.cloud || [];
const sshKeys = data.sshKeys || [];
const networks = data.data.networks || [];
const ips = data.data.ips.filter(ip => !ip.assignedTo) || [];
const firewalls = data.data.firewalls || [];
const initScripts = data.initScripts || [];
const pricing = data.pricing;
const bareMetals = data.data.bareMetals || [];
---

<AutarkLayout
  title="Create Virtual Machine"
  description="Launch a new VM with custom or preset configuration."
  currentPath="/infrastructure/vms"
>
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
      <a href="/infrastructure/vms" class="text-sm text-primary hover:underline mb-4 inline-block">
        ← Back to Virtual Machines
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Form Column -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-lg shadow border border-gray-200">
          <!-- Step Indicator -->
          <div class="border-b border-gray-200 px-6 py-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2 step-indicator" data-step-num="1">
                <div class="step-circle flex items-center justify-center w-8 h-8 rounded-full bg-primary text-white text-sm font-medium">1</div>
                <span class="step-label text-sm font-medium text-gray-900">Sizing</span>
              </div>
              <div class="flex-1 h-px bg-gray-200 mx-2"></div>
              <div class="flex items-center space-x-2 step-indicator" data-step-num="2">
                <div class="step-circle flex items-center justify-center w-8 h-8 rounded-full bg-gray-200 text-gray-500 text-sm font-medium">2</div>
                <span class="step-label text-sm font-medium text-gray-500">Placement</span>
              </div>
              <div class="flex-1 h-px bg-gray-200 mx-2"></div>
              <div class="flex items-center space-x-2 step-indicator" data-step-num="3">
                <div class="step-circle flex items-center justify-center w-8 h-8 rounded-full bg-gray-200 text-gray-500 text-sm font-medium">3</div>
                <span class="step-label text-sm font-medium text-gray-500">GPU</span>
              </div>
              <div class="flex-1 h-px bg-gray-200 mx-2"></div>
              <div class="flex items-center space-x-2 step-indicator" data-step-num="4">
                <div class="step-circle flex items-center justify-center w-8 h-8 rounded-full bg-gray-200 text-gray-500 text-sm font-medium">4</div>
                <span class="step-label text-sm font-medium text-gray-500">Image</span>
              </div>
              <div class="flex-1 h-px bg-gray-200 mx-2"></div>
              <div class="flex items-center space-x-2 step-indicator" data-step-num="5">
                <div class="step-circle flex items-center justify-center w-8 h-8 rounded-full bg-gray-200 text-gray-500 text-sm font-medium">5</div>
                <span class="step-label text-sm font-medium text-gray-500">Network</span>
              </div>
              <div class="flex-1 h-px bg-gray-200 mx-2"></div>
              <div class="flex items-center space-x-2 step-indicator" data-step-num="6">
                <div class="step-circle flex items-center justify-center w-8 h-8 rounded-full bg-gray-200 text-gray-500 text-sm font-medium">6</div>
                <span class="step-label text-sm font-medium text-gray-500">Security</span>
              </div>
            </div>
          </div>

          <!-- Form Steps -->
          <form id="vm-create-form" class="p-6">
            <!-- Step 1: Sizing -->
            <div class="step-content" data-step-num="1">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">VM Sizing</h3>

              <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Choose Configuration Method</label>
                <div class="grid grid-cols-2 gap-4">
                  <label class="sizing-method-label relative flex cursor-pointer rounded-lg border-2 border-primary ring-2 ring-primary bg-white p-4 hover:border-primary transition-colors">
                    <input type="radio" name="sizing-method" value="preset" checked class="sr-only" />
                    <div class="flex flex-col">
                      <span class="block text-sm font-medium text-gray-900">Use Preset</span>
                      <span class="mt-1 text-xs text-gray-500">Select from predefined configurations</span>
                    </div>
                  </label>
                  <label class="sizing-method-label relative flex cursor-pointer rounded-lg border-2 border-gray-300 bg-white p-4 hover:border-primary transition-colors">
                    <input type="radio" name="sizing-method" value="custom" class="sr-only" />
                    <div class="flex flex-col">
                      <span class="block text-sm font-medium text-gray-900">Custom</span>
                      <span class="mt-1 text-xs text-gray-500">Specify your own configuration</span>
                    </div>
                  </label>
                </div>
              </div>

              <div id="preset-sizing" class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Select Preset</label>
                <select name="preset-id" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                  <option value="">-- Select a preset --</option>
                  {presets.map(p => (
                    <option value={p.id} data-vcpus={p.vcpus} data-ram={p.ramGB} data-disk={p.systemDiskGB}>
                      {p.name} - {p.vcpus} vCPU, {p.ramGB} GB RAM, {p.systemDiskGB} GB Disk (€{p.monthlyPrice}/mo)
                    </option>
                  ))}
                </select>
              </div>

              <div id="custom-sizing" class="hidden space-y-6">
                <!-- CPU Architecture -->
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">CPU Architecture</label>
                  <div class="grid grid-cols-2 gap-4">
                    <label class="cpu-arch-label relative flex cursor-pointer rounded-lg border-2 border-primary ring-2 ring-primary bg-white p-4 hover:border-primary transition-colors">
                      <input type="radio" name="cpu-arch" value="x86" checked class="sr-only" />
                      <div class="flex flex-col">
                        <span class="block text-sm font-medium text-gray-900">x86_64</span>
                        <span class="mt-1 text-xs text-gray-500">Intel/AMD processors</span>
                      </div>
                    </label>
                    <label class="cpu-arch-label relative flex cursor-pointer rounded-lg border-2 border-gray-300 bg-white p-4 hover:border-primary transition-colors">
                      <input type="radio" name="cpu-arch" value="arm" class="sr-only" />
                      <div class="flex flex-col">
                        <span class="block text-sm font-medium text-gray-900">ARM64</span>
                        <span class="mt-1 text-xs text-gray-500">ARM-based processors</span>
                      </div>
                    </label>
                  </div>
                </div>

                <!-- Capacity Type -->
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Capacity Type</label>
                  <div class="grid grid-cols-2 gap-4">
                    <label class="capacity-type-label relative flex cursor-pointer rounded-lg border-2 border-gray-300 bg-white p-4 hover:border-primary transition-colors">
                      <input type="radio" name="capacity-type" value="shared" checked class="sr-only" />
                      <div class="flex flex-col">
                        <span class="block text-sm font-medium text-gray-900">Shared</span>
                        <span class="mt-1 text-xs text-gray-500">Cost-effective, shared resources</span>
                      </div>
                    </label>
                    <label class="capacity-type-label relative flex cursor-pointer rounded-lg border-2 border-gray-300 bg-white p-4 hover:border-primary transition-colors">
                      <input type="radio" name="capacity-type" value="dedicated" class="sr-only" />
                      <div class="flex flex-col">
                        <span class="block text-sm font-medium text-gray-900">Dedicated</span>
                        <span class="mt-1 text-xs text-gray-500">Guaranteed performance</span>
                      </div>
                    </label>
                  </div>
                </div>

                <!-- vCPUs Slider -->
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <label class="block text-sm font-medium text-gray-700">vCPUs</label>
                    <span class="text-sm font-semibold text-primary" id="vcpus-value">2</span>
                  </div>
                  <input type="range" name="vcpus" min="1" max="64" value="2" step="1" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer slider" id="vcpus-slider" />
                  <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>1</span>
                    <span>64</span>
                  </div>
                </div>

                <!-- RAM Slider -->
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <label class="block text-sm font-medium text-gray-700">RAM (GB)</label>
                    <span class="text-sm font-semibold text-primary" id="ram-value">4</span>
                  </div>
                  <input type="range" name="ram-gb" min="1" max="512" value="4" step="1" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer slider" id="ram-slider" />
                  <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>1 GB</span>
                    <span>512 GB</span>
                  </div>
                </div>

                <!-- System Disk Slider -->
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <label class="block text-sm font-medium text-gray-700">System Disk (GB)</label>
                    <span class="text-sm font-semibold text-primary" id="disk-value">80</span>
                  </div>
                  <input type="range" name="disk-gb" min="20" max="2000" value="80" step="10" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer slider" id="disk-slider" />
                  <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>20 GB</span>
                    <span>2000 GB</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 2: Placement -->
            <div class="step-content hidden" data-step-num="2">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">Placement</h3>

              <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Provider Type</label>
                <div class="grid grid-cols-2 gap-4">
                  <label class="provider-type-label relative flex cursor-pointer rounded-lg border-2 border-primary ring-2 ring-primary bg-white p-4 hover:border-primary transition-colors">
                    <input type="radio" name="provider-type" value="selfHosted" checked class="sr-only" />
                    <div class="flex flex-col">
                      <span class="block text-sm font-medium text-gray-900">Self-Hosted</span>
                      <span class="mt-1 text-xs text-gray-500">On-premise data centers</span>
                    </div>
                  </label>
                  <label class="provider-type-label relative flex cursor-pointer rounded-lg border-2 border-gray-300 bg-white p-4 hover:border-primary transition-colors">
                    <input type="radio" name="provider-type" value="cloud" class="sr-only" />
                    <div class="flex flex-col">
                      <span class="block text-sm font-medium text-gray-900">Cloud Provider</span>
                      <span class="mt-1 text-xs text-gray-500">External cloud resources</span>
                    </div>
                  </label>
                </div>
              </div>

              <div id="selfhosted-location" class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Data Center</label>
                  <select name="location-id" id="datacenter-filter" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="">All data centers</option>
                    {locations.map(loc => (
                      <option value={loc.id}>{loc.name} ({loc.location})</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Bare Metal Host</label>

                  <!-- Auto-Select Option -->
                  <label class="host-selection-label relative flex cursor-pointer rounded-lg border-2 border-primary ring-2 ring-primary bg-white p-4 hover:border-primary transition-colors mb-4">
                    <input type="radio" name="host-selection" value="auto" checked class="sr-only" />
                    <div class="flex flex-col w-full">
                      <div class="flex items-center justify-between">
                        <span class="block text-sm font-medium text-gray-900">Auto-Select</span>
                        <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">Recommended</span>
                      </div>
                      <span class="mt-1 text-xs text-gray-500">Automatically choose the best available host based on your requirements</span>
                    </div>
                  </label>

                  <!-- Manual Selection Option -->
                  <label class="host-selection-label relative flex cursor-pointer rounded-lg border-2 border-gray-300 bg-white p-4 hover:border-primary transition-colors mb-4">
                    <input type="radio" name="host-selection" value="manual" class="sr-only" />
                    <div class="flex flex-col">
                      <span class="block text-sm font-medium text-gray-900">Manual Selection</span>
                      <span class="mt-1 text-xs text-gray-500">Choose a specific bare metal host</span>
                    </div>
                  </label>

                  <!-- Host Selection Table -->
                  <div id="host-selection-table" class="hidden">
                    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                      <div class="max-h-96 overflow-y-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                          <thead class="bg-gray-50 sticky top-0">
                            <tr>
                              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Select</th>
                              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Hostname</th>
                              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Location</th>
                              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">CPU</th>
                              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">RAM</th>
                              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Storage</th>
                            </tr>
                          </thead>
                          <tbody class="divide-y divide-gray-200" id="host-table-body">
                            {bareMetals.map(bm => {
                              const cpuUsagePercent = bm.usage && bm.cpuCores ? Math.round((bm.usage.cpuCores / bm.cpuCores) * 100) : 0;
                              const ramUsagePercent = bm.usage && bm.ramGB ? Math.round((bm.usage.ramGB / bm.ramGB) * 100) : 0;
                              const storageUsagePercent = bm.usage && bm.storageTB ? Math.round((bm.usage.storageTB / bm.storageTB) * 100) : 0;

                              return (
                              <tr
                                class="host-row hover:bg-gray-50 cursor-pointer relative"
                                data-host-id={bm.id}
                                data-location={bm.locationId}
                                data-cpu-cores={bm.cpuCores}
                                data-ram-gb={bm.ramGB}
                                data-storage-tb={bm.storageTB}
                                data-cpu-used={bm.usage?.cpuCores || 0}
                                data-ram-used={bm.usage?.ramGB || 0}
                                data-storage-used={bm.usage?.storageTB || 0}
                                data-status={bm.status}
                              >
                                <td class="px-4 py-3">
                                  <input
                                    type="radio"
                                    name="bare-metal-host"
                                    value={bm.id}
                                    class="host-radio rounded border-gray-300 text-primary focus:ring-primary"
                                  />
                                </td>
                                <td class="px-4 py-3">
                                  <div class="flex items-center gap-2">
                                    <div>
                                      <div class="text-sm font-medium text-gray-900">{bm.hostname}</div>
                                      <div class="text-xs text-gray-500">{bm.mgmtIP}</div>
                                    </div>
                                    <span class="recommended-badge hidden text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded font-medium">Recommended</span>
                                  </div>
                                </td>
                                <td class="px-4 py-3 text-sm">{bm.locationId}</td>
                                <td class="px-4 py-3">
                                  <div class="w-24">
                                    <div class="flex justify-between text-xs text-gray-600 mb-1">
                                      <span>{bm.usage?.cpuCores || 0}/{bm.cpuCores}</span>
                                      <span>{cpuUsagePercent}%</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-1.5">
                                      <div
                                        class="bg-blue-600 h-1.5 rounded-full"
                                        style={`width: ${cpuUsagePercent}%`}
                                      ></div>
                                    </div>
                                  </div>
                                </td>
                                <td class="px-4 py-3">
                                  <div class="w-24">
                                    <div class="flex justify-between text-xs text-gray-600 mb-1">
                                      <span>{bm.usage?.ramGB || 0}/{bm.ramGB}GB</span>
                                      <span>{ramUsagePercent}%</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-1.5">
                                      <div
                                        class="bg-green-600 h-1.5 rounded-full"
                                        style={`width: ${ramUsagePercent}%`}
                                      ></div>
                                    </div>
                                  </div>
                                </td>
                                <td class="px-4 py-3">
                                  <div class="w-24">
                                    <div class="flex justify-between text-xs text-gray-600 mb-1">
                                      <span>{bm.usage?.storageTB || 0}/{bm.storageTB}TB</span>
                                      <span>{storageUsagePercent}%</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-1.5">
                                      <div
                                        class="bg-purple-600 h-1.5 rounded-full"
                                        style={`width: ${storageUsagePercent}%`}
                                      ></div>
                                    </div>
                                  </div>
                                </td>
                              </tr>
                            )})}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div id="cloud-provider" class="hidden space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Cloud Provider</label>
                  <select name="cloud-provider-id" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="">-- Select provider --</option>
                    {cloudProviders.map(cp => (
                      <option value={cp.id} data-regions={JSON.stringify(cp.regions)}>{cp.name}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Region</label>
                  <select name="cloud-region" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="">-- Select region --</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Step 3: GPU -->
            <div class="step-content hidden" data-step-num="3">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">GPU Configuration</h3>

              <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">GPU Model</label>
                <select name="gpu-model" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                  <option value="">None</option>
                  <option value="A6000">NVIDIA A6000 (€{pricing.vm.gpuPerHour.A6000}/hour)</option>
                  <option value="H100">NVIDIA H100 (€{pricing.vm.gpuPerHour.H100}/hour)</option>
                  <option value="H200">NVIDIA H200 (€{pricing.vm.gpuPerHour.H200}/hour)</option>
                </select>
              </div>

              <div id="gpu-count-field" class="hidden">
                <label class="block text-sm font-medium text-gray-700 mb-2">GPU Count</label>
                <input type="number" name="gpu-count" min="1" value="1" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" />
              </div>

              <div class="mt-4 p-4 bg-blue-50 rounded text-sm text-gray-700">
                <strong>Note:</strong> GPU availability depends on the selected data center. High-end GPUs like H100 and H200 may have limited availability.
              </div>
            </div>

            <!-- Step 4: Image & Access -->
            <div class="step-content hidden" data-step-num="4">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">Image & Access</h3>

              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">VM Name</label>
                  <input type="text" name="vm-name" placeholder="e.g., web-server-1" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" required />
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Operating System Image</label>
                  <select name="image" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="ubuntu-22.04">Ubuntu 22.04 LTS</option>
                    <option value="ubuntu-24.04">Ubuntu 24.04 LTS</option>
                    <option value="debian-12">Debian 12</option>
                    <option value="debian-13">Debian 13</option>
                    <option value="fedora-41">Fedora 41</option>
                    <option value="fedora-42">Fedora 42</option>
                    <option value="suse-15">SUSE Linux 15</option>
                    <option value="windows-2022">Windows Server 2022</option>
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">SSH Key</label>
                  <select name="ssh-key-id" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="">-- Select SSH key --</option>
                    {sshKeys.map(key => (
                      <option value={key.id}>{key.name} ({key.fingerprint.substring(0, 20)}...)</option>
                    ))}
                  </select>
                </div>
              </div>
            </div>

            <!-- Step 5: Networking -->
            <div class="step-content hidden" data-step-num="5">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">Networking</h3>

              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Network (VPC)</label>
                  <select name="network-id" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="">-- Select network --</option>
                    {networks.map(net => (
                      <option value={net.id} data-subnets={JSON.stringify(net.subnets)}>{net.name} ({net.cidr})</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Subnet</label>
                  <select name="subnet-id" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="">-- Select subnet --</option>
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Public IP Addresses</label>
                  <div class="border border-gray-200 rounded p-3 max-h-40 overflow-y-auto bg-gray-50">
                    {ips.slice(0, 10).map(ip => (
                      <label class="flex items-center py-1 hover:bg-gray-100 px-2 rounded cursor-pointer">
                        <input type="checkbox" name="ip-assignments" value={ip.id} class="rounded border-gray-300 text-primary focus:ring-primary" />
                        <span class="ml-2 text-sm text-gray-700">{ip.address} ({ip.poolId})</span>
                      </label>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 6: Security & Backups -->
            <div class="step-content hidden" data-step-num="6">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">Security & Backups</h3>

              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Firewall Rules</label>
                  <div class="border border-gray-200 rounded p-3 max-h-40 overflow-y-auto bg-gray-50">
                    {firewalls.map(fw => (
                      <label class="flex items-center py-1 hover:bg-gray-100 px-2 rounded cursor-pointer">
                        <input type="checkbox" name="firewall-ids" value={fw.id} class="rounded border-gray-300 text-primary focus:ring-primary" />
                        <span class="ml-2 text-sm text-gray-700">{fw.name} ({fw.defaultPolicy})</span>
                      </label>
                    ))}
                  </div>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Backup Schedule</label>
                  <select name="backup-schedule" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="no">No backups</option>
                    <option value="daily">Daily backups</option>
                    <option value="weekly">Weekly backups</option>
                  </select>
                </div>

                <div id="retention-field" class="hidden">
                  <label class="block text-sm font-medium text-gray-700 mb-2">Backup Retention (copies)</label>
                  <input type="number" name="retention" min="1" max="30" value="7" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" />
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Init Script (Optional)</label>
                  <select name="init-script-id" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
                    <option value="">-- No init script --</option>
                    {initScripts.map(script => (
                      <option value={script.id}>{script.name} - {script.description}</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Tags</label>
                  <input type="text" name="tags" placeholder="env:prod, app:web" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" />
                  <p class="mt-1 text-xs text-gray-500">Comma-separated key:value pairs</p>
                </div>
              </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="flex justify-between mt-6 pt-6 border-t border-gray-200">
              <button type="button" id="prev-btn" class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50 hidden">
                Previous
              </button>
              <div class="flex gap-2 ml-auto">
                <a href="/infrastructure/vms" class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
                  Cancel
                </a>
                <button type="button" id="next-btn" class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
                  Next
                </button>
                <button type="submit" id="submit-btn" class="px-4 py-2 bg-success text-white rounded text-sm font-medium hover:bg-green-600 hidden">
                  Create VM
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Cost Estimator Sidebar -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-lg shadow border border-gray-200 p-6 sticky top-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Cost Estimate</h3>

          <div class="space-y-3 text-sm">
            <div class="flex justify-between">
              <span class="text-gray-600">vCPUs:</span>
              <span class="font-medium" id="cost-vcpus">0 x €{pricing.vm.vCPUPerMonth}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">RAM:</span>
              <span class="font-medium" id="cost-ram">0 GB x €{pricing.vm.ramGBPerMonth}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">System Disk:</span>
              <span class="font-medium" id="cost-disk">0 GB x €{pricing.vm.systemDiskGBPerMonth}</span>
            </div>
            <div class="flex justify-between hidden" id="cost-gpu-row">
              <span class="text-gray-600">GPU:</span>
              <span class="font-medium" id="cost-gpu">-</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">Public IPs:</span>
              <span class="font-medium" id="cost-ips">0 x €{pricing.vm.publicIPv4PerMonth}</span>
            </div>
            <div class="flex justify-between hidden" id="cost-dedicated-row">
              <span class="text-gray-600">Dedicated Capacity:</span>
              <span class="font-medium" id="cost-dedicated">+50%</span>
            </div>

            <div class="pt-3 border-t border-gray-200">
              <div class="flex justify-between items-center">
                <span class="text-gray-900 font-semibold">Monthly Total:</span>
                <span class="text-2xl font-bold text-primary" id="cost-total">€0.00</span>
              </div>
            </div>
          </div>

          <div class="mt-6 p-3 bg-blue-50 rounded text-xs text-gray-600">
            Prices are estimates. Actual costs may vary based on usage and additional resources.
          </div>
        </div>
      </div>
    </div>
  </div>
</AutarkLayout>

<script define:vars={{ pricing }}>
  (function() {
    let currentStep = 1;
    const totalSteps = 6;

    // Wizard navigation
    function showStep(step) {
      console.log('Showing step:', step);

      // Hide all step contents
      const stepContents = document.querySelectorAll('.step-content');
      stepContents.forEach(function(el) {
        el.classList.add('hidden');
      });

      // Show current step content
      const currentStepContent = document.querySelector('.step-content[data-step-num="' + step + '"]');
      if (currentStepContent) {
        currentStepContent.classList.remove('hidden');
      }

      // Update step indicators
      const stepIndicators = document.querySelectorAll('.step-indicator');
      stepIndicators.forEach(function(indicator) {
        const stepNum = parseInt(indicator.getAttribute('data-step-num') || '0');
        const circle = indicator.querySelector('.step-circle');
        const label = indicator.querySelector('.step-label');

        if (stepNum < step) {
          // Completed steps
          if (circle) {
            circle.classList.remove('bg-gray-200', 'bg-primary', 'text-gray-500');
            circle.classList.add('bg-green-500', 'text-white');
          }
          if (label) {
            label.classList.remove('text-gray-500');
            label.classList.add('text-gray-900');
          }
        } else if (stepNum === step) {
          // Current step
          if (circle) {
            circle.classList.remove('bg-gray-200', 'bg-green-500', 'text-gray-500');
            circle.classList.add('bg-primary', 'text-white');
          }
          if (label) {
            label.classList.remove('text-gray-500');
            label.classList.add('text-gray-900');
          }
        } else {
          // Future steps
          if (circle) {
            circle.classList.remove('bg-primary', 'bg-green-500', 'text-white');
            circle.classList.add('bg-gray-200', 'text-gray-500');
          }
          if (label) {
            label.classList.remove('text-gray-900');
            label.classList.add('text-gray-500');
          }
        }
      });

      // Update buttons
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      const submitBtn = document.getElementById('submit-btn');

      if (prevBtn) {
        if (step === 1) {
          prevBtn.classList.add('hidden');
        } else {
          prevBtn.classList.remove('hidden');
        }
      }

      if (nextBtn) {
        if (step === totalSteps) {
          nextBtn.classList.add('hidden');
        } else {
          nextBtn.classList.remove('hidden');
        }
      }

      if (submitBtn) {
        if (step !== totalSteps) {
          submitBtn.classList.add('hidden');
        } else {
          submitBtn.classList.remove('hidden');
        }
      }

      currentStep = step;

      // Scroll to top of form
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Navigation button handlers
    const nextBtn = document.getElementById('next-btn');
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        console.log('Next clicked, current step:', currentStep);
        if (currentStep < totalSteps) {
          showStep(currentStep + 1);
        }
      });
    }

    const prevBtn = document.getElementById('prev-btn');
    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        console.log('Previous clicked, current step:', currentStep);
        if (currentStep > 1) {
          showStep(currentStep - 1);
        }
      });
    }

    // Radio button visual feedback
    function updateRadioStyles() {
      // Sizing method labels
      const sizingLabels = document.querySelectorAll('.sizing-method-label');
      sizingLabels.forEach(function(label) {
        const input = label.querySelector('input[type="radio"]');
        if (input && input.checked) {
          label.classList.add('border-primary', 'ring-2', 'ring-primary');
          label.classList.remove('border-gray-300');
        } else {
          label.classList.remove('border-primary', 'ring-2', 'ring-primary');
          label.classList.add('border-gray-300');
        }
      });

      // CPU arch labels
      const cpuArchLabels = document.querySelectorAll('.cpu-arch-label');
      cpuArchLabels.forEach(function(label) {
        const input = label.querySelector('input[type="radio"]');
        if (input && input.checked) {
          label.classList.add('border-primary', 'ring-2', 'ring-primary');
          label.classList.remove('border-gray-300');
        } else {
          label.classList.remove('border-primary', 'ring-2', 'ring-primary');
          label.classList.add('border-gray-300');
        }
      });

      // Capacity type labels
      const capacityLabels = document.querySelectorAll('.capacity-type-label');
      capacityLabels.forEach(function(label) {
        const input = label.querySelector('input[type="radio"]');
        if (input && input.checked) {
          label.classList.add('border-primary', 'ring-2', 'ring-primary');
          label.classList.remove('border-gray-300');
        } else {
          label.classList.remove('border-primary', 'ring-2', 'ring-primary');
          label.classList.add('border-gray-300');
        }
      });

      // Provider type labels
      const providerLabels = document.querySelectorAll('.provider-type-label');
      providerLabels.forEach(function(label) {
        const input = label.querySelector('input[type="radio"]');
        if (input && input.checked) {
          label.classList.add('border-primary', 'ring-2', 'ring-primary');
          label.classList.remove('border-gray-300');
        } else {
          label.classList.remove('border-primary', 'ring-2', 'ring-primary');
          label.classList.add('border-gray-300');
        }
      });

      // Host selection labels
      const hostSelectionLabels = document.querySelectorAll('.host-selection-label');
      hostSelectionLabels.forEach(function(label) {
        const input = label.querySelector('input[type="radio"]');
        if (input && input.checked) {
          label.classList.add('border-primary', 'ring-2', 'ring-primary');
          label.classList.remove('border-gray-300');
        } else {
          label.classList.remove('border-primary', 'ring-2', 'ring-primary');
          label.classList.add('border-gray-300');
        }
      });
    }

    // Get VM requirements
    function getVMRequirements() {
      const methodRadio = document.querySelector('input[name="sizing-method"]:checked');
      const method = methodRadio ? methodRadio.value : 'preset';
      let vcpus = 0, ramGB = 0, diskGB = 0;

      if (method === 'preset') {
        const presetSelect = document.querySelector('select[name="preset-id"]');
        if (presetSelect) {
          const selectedOption = presetSelect.options[presetSelect.selectedIndex];
          vcpus = parseInt(selectedOption.getAttribute('data-vcpus') || '0');
          ramGB = parseInt(selectedOption.getAttribute('data-ram') || '0');
          diskGB = parseInt(selectedOption.getAttribute('data-disk') || '0');
        }
      } else {
        const vcpusInput = document.querySelector('input[name="vcpus"]');
        const ramInput = document.querySelector('input[name="ram-gb"]');
        const diskInput = document.querySelector('input[name="disk-gb"]');

        vcpus = vcpusInput ? parseInt(vcpusInput.value || '0') : 0;
        ramGB = ramInput ? parseInt(ramInput.value || '0') : 0;
        diskGB = diskInput ? parseInt(diskInput.value || '0') : 0;
      }

      return { vcpus, ramGB, diskGB: diskGB / 1000 }; // Convert GB to TB
    }

    // Validate and update host table
    function validateHostCapacity() {
      const requirements = getVMRequirements();
      const datacenterFilter = document.getElementById('datacenter-filter');
      const selectedDatacenter = datacenterFilter ? datacenterFilter.value : '';

      const hostRows = document.querySelectorAll('.host-row');
      let recommendedHost = null;
      let bestScore = -1;

      // First pass: evaluate all hosts
      const hostEvaluations = [];
      hostRows.forEach(function(row) {
        const hostLocation = row.getAttribute('data-location');
        const cpuCores = parseFloat(row.getAttribute('data-cpu-cores') || '0');
        const ramGB = parseFloat(row.getAttribute('data-ram-gb') || '0');
        const storageTB = parseFloat(row.getAttribute('data-storage-tb') || '0');
        const cpuUsed = parseFloat(row.getAttribute('data-cpu-used') || '0');
        const ramUsed = parseFloat(row.getAttribute('data-ram-used') || '0');
        const storageUsed = parseFloat(row.getAttribute('data-storage-used') || '0');
        const status = row.getAttribute('data-status');

        // Calculate available resources
        const cpuAvailable = cpuCores - cpuUsed;
        const ramAvailable = ramGB - ramUsed;
        const storageAvailable = storageTB - storageUsed;

        // Check if host matches datacenter filter
        const matchesFilter = !selectedDatacenter || hostLocation === selectedDatacenter;

        // Check capacity
        const hasCpu = cpuAvailable >= requirements.vcpus;
        const hasRam = ramAvailable >= requirements.ramGB;
        const hasStorage = storageAvailable >= requirements.diskGB;
        const isReady = status === 'ready';

        const hasSufficientCapacity = hasCpu && hasRam && hasStorage && isReady;

        // Calculate score for recommendation (lower utilization is better)
        let score = 0;
        if (hasSufficientCapacity && matchesFilter) {
          const cpuUtilAfter = ((cpuUsed + requirements.vcpus) / cpuCores) * 100;
          const ramUtilAfter = ((ramUsed + requirements.ramGB) / ramGB) * 100;
          const storageUtilAfter = ((storageUsed + requirements.diskGB) / storageTB) * 100;

          // Lower average utilization is better (inversed score)
          const avgUtil = (cpuUtilAfter + ramUtilAfter + storageUtilAfter) / 3;
          score = 100 - avgUtil; // Higher score for lower utilization
        }

        hostEvaluations.push({
          row,
          hasSufficientCapacity,
          matchesFilter,
          score,
          cpuAvailable,
          ramAvailable,
          storageAvailable,
          hasCpu,
          hasRam,
          hasStorage,
          isReady
        });

        if (score > bestScore) {
          bestScore = score;
          recommendedHost = row;
        }
      });

      // Second pass: apply styles and tooltips
      hostEvaluations.forEach(function(evaluation) {
        const row = evaluation.row;
        const radio = row.querySelector('.host-radio');
        const recommendedBadge = row.querySelector('.recommended-badge');

        // Apply filtering
        if (!evaluation.matchesFilter) {
          row.style.display = 'none';
          return;
        } else {
          row.style.display = '';
        }

        // Remove old tooltip if exists
        row.removeAttribute('title');

        // Apply capacity validation
        if (!evaluation.hasSufficientCapacity) {
          row.classList.add('opacity-50', 'bg-gray-100');
          row.classList.remove('hover:bg-gray-50', 'cursor-pointer');
          if (radio) {
            radio.disabled = true;
            radio.classList.add('cursor-not-allowed');
          }

          // Build tooltip message
          let reasons = [];
          if (!evaluation.isReady) reasons.push('Not ready');
          if (!evaluation.hasCpu) reasons.push(`CPU: Need ${requirements.vcpus}, only ${evaluation.cpuAvailable.toFixed(1)} available`);
          if (!evaluation.hasRam) reasons.push(`RAM: Need ${requirements.ramGB}GB, only ${evaluation.ramAvailable.toFixed(1)}GB available`);
          if (!evaluation.hasStorage) reasons.push(`Storage: Need ${requirements.diskGB.toFixed(2)}TB, only ${evaluation.storageAvailable.toFixed(2)}TB available`);

          if (reasons.length > 0) {
            row.setAttribute('title', 'Insufficient capacity: ' + reasons.join('; '));
          }
        } else {
          row.classList.remove('opacity-50', 'bg-gray-100');
          row.classList.add('hover:bg-gray-50', 'cursor-pointer');
          if (radio) {
            radio.disabled = false;
            radio.classList.remove('cursor-not-allowed');
          }
        }

        // Show/hide recommended badge
        if (recommendedBadge) {
          if (row === recommendedHost) {
            recommendedBadge.classList.remove('hidden');
          } else {
            recommendedBadge.classList.add('hidden');
          }
        }
      });
    }

    // Host selection toggle
    const hostSelectionRadios = document.querySelectorAll('input[name="host-selection"]');
    hostSelectionRadios.forEach(function(radio) {
      radio.addEventListener('change', function(e) {
        const table = document.getElementById('host-selection-table');
        if (e.target.value === 'manual') {
          if (table) table.classList.remove('hidden');
          validateHostCapacity();
        } else {
          if (table) table.classList.add('hidden');
        }
        updateRadioStyles();
      });
    });

    // Datacenter filter
    const datacenterFilter = document.getElementById('datacenter-filter');
    if (datacenterFilter) {
      datacenterFilter.addEventListener('change', function() {
        validateHostCapacity();
      });
    }

    // Make host rows clickable
    const hostRows = document.querySelectorAll('.host-row');
    hostRows.forEach(function(row) {
      row.addEventListener('click', function(e) {
        if (e.target.type === 'radio') return; // Let radio handle itself
        const radio = row.querySelector('.host-radio');
        if (radio && !radio.disabled) {
          radio.checked = true;
        }
      });
    });

    // Sizing method toggle
    const sizingMethodRadios = document.querySelectorAll('input[name="sizing-method"]');
    sizingMethodRadios.forEach(function(radio) {
      radio.addEventListener('change', function(e) {
        const target = e.target;
        const presetSizing = document.getElementById('preset-sizing');
        const customSizing = document.getElementById('custom-sizing');

        if (target.value === 'preset') {
          if (presetSizing) presetSizing.classList.remove('hidden');
          if (customSizing) customSizing.classList.add('hidden');
        } else {
          if (presetSizing) presetSizing.classList.add('hidden');
          if (customSizing) customSizing.classList.remove('hidden');
        }
        updateRadioStyles();
        updateCostEstimate();

        // Re-validate host capacity if manual selection is active
        const manualSelection = document.querySelector('input[name="host-selection"][value="manual"]:checked');
        if (manualSelection) {
          validateHostCapacity();
        }
      });
    });

    // CPU arch toggle
    const cpuArchRadios = document.querySelectorAll('input[name="cpu-arch"]');
    cpuArchRadios.forEach(function(radio) {
      radio.addEventListener('change', function() {
        updateRadioStyles();
      });
    });

    // Capacity type toggle
    const capacityTypeRadios = document.querySelectorAll('input[name="capacity-type"]');
    capacityTypeRadios.forEach(function(radio) {
      radio.addEventListener('change', function() {
        updateRadioStyles();
        updateCostEstimate();
      });
    });

    // Slider value displays
    const vcpusSlider = document.getElementById('vcpus-slider');
    const vcpusValue = document.getElementById('vcpus-value');
    if (vcpusSlider && vcpusValue) {
      vcpusSlider.addEventListener('input', function(e) {
        vcpusValue.textContent = e.target.value;
        updateCostEstimate();

        // Re-validate host capacity if manual selection is active
        const manualSelection = document.querySelector('input[name="host-selection"][value="manual"]:checked');
        if (manualSelection) {
          validateHostCapacity();
        }
      });
    }

    const ramSlider = document.getElementById('ram-slider');
    const ramValue = document.getElementById('ram-value');
    if (ramSlider && ramValue) {
      ramSlider.addEventListener('input', function(e) {
        ramValue.textContent = e.target.value;
        updateCostEstimate();

        // Re-validate host capacity if manual selection is active
        const manualSelection = document.querySelector('input[name="host-selection"][value="manual"]:checked');
        if (manualSelection) {
          validateHostCapacity();
        }
      });
    }

    const diskSlider = document.getElementById('disk-slider');
    const diskValue = document.getElementById('disk-value');
    if (diskSlider && diskValue) {
      diskSlider.addEventListener('input', function(e) {
        diskValue.textContent = e.target.value;
        updateCostEstimate();

        // Re-validate host capacity if manual selection is active
        const manualSelection = document.querySelector('input[name="host-selection"][value="manual"]:checked');
        if (manualSelection) {
          validateHostCapacity();
        }
      });
    }

    // Provider type toggle
    const providerTypeRadios = document.querySelectorAll('input[name="provider-type"]');
    providerTypeRadios.forEach(function(radio) {
      radio.addEventListener('change', function(e) {
        const target = e.target;
        const selfhosted = document.getElementById('selfhosted-location');
        const cloud = document.getElementById('cloud-provider');

        if (target.value === 'selfHosted') {
          if (selfhosted) selfhosted.classList.remove('hidden');
          if (cloud) cloud.classList.add('hidden');
        } else {
          if (selfhosted) selfhosted.classList.add('hidden');
          if (cloud) cloud.classList.remove('hidden');
        }
        updateRadioStyles();
      });
    });

    // Cloud provider region population
    const cloudProviderSelect = document.querySelector('select[name="cloud-provider-id"]');
    if (cloudProviderSelect) {
      cloudProviderSelect.addEventListener('change', function(e) {
        const target = e.target;
        const regionSelect = document.querySelector('select[name="cloud-region"]');
        const selectedOption = target.options[target.selectedIndex];
        const regions = selectedOption.getAttribute('data-regions');

        if (regionSelect) {
          regionSelect.innerHTML = '<option value="">-- Select region --</option>';
          if (regions) {
            const regionList = JSON.parse(regions);
            regionList.forEach(function(region) {
              const option = document.createElement('option');
              option.value = region;
              option.textContent = region;
              regionSelect.appendChild(option);
            });
          }
        }
      });
    }

    // GPU count field toggle
    const gpuModelSelect = document.querySelector('select[name="gpu-model"]');
    if (gpuModelSelect) {
      gpuModelSelect.addEventListener('change', function(e) {
        const target = e.target;
        const gpuCountField = document.getElementById('gpu-count-field');
        if (target.value) {
          if (gpuCountField) gpuCountField.classList.remove('hidden');
        } else {
          if (gpuCountField) gpuCountField.classList.add('hidden');
        }
        updateCostEstimate();
      });
    }

    // Network subnet population
    const networkSelect = document.querySelector('select[name="network-id"]');
    if (networkSelect) {
      networkSelect.addEventListener('change', function(e) {
        const target = e.target;
        const subnetSelect = document.querySelector('select[name="subnet-id"]');
        const selectedOption = target.options[target.selectedIndex];
        const subnets = selectedOption.getAttribute('data-subnets');

        if (subnetSelect) {
          subnetSelect.innerHTML = '<option value="">-- Select subnet --</option>';
          if (subnets) {
            const subnetList = JSON.parse(subnets);
            subnetList.forEach(function(subnet) {
              const option = document.createElement('option');
              option.value = subnet.id;
              option.textContent = subnet.name + ' (' + subnet.cidr + ')';
              subnetSelect.appendChild(option);
            });
          }
        }
      });
    }

    // Backup retention field toggle
    const backupScheduleSelect = document.querySelector('select[name="backup-schedule"]');
    if (backupScheduleSelect) {
      backupScheduleSelect.addEventListener('change', function(e) {
        const target = e.target;
        const retentionField = document.getElementById('retention-field');
        if (target.value !== 'no') {
          if (retentionField) retentionField.classList.remove('hidden');
        } else {
          if (retentionField) retentionField.classList.add('hidden');
        }
      });
    }

    // Cost estimation
    function updateCostEstimate() {
      const methodRadio = document.querySelector('input[name="sizing-method"]:checked');
      const method = methodRadio ? methodRadio.value : 'preset';
      let vcpus = 0, ramGB = 0, diskGB = 0;

      if (method === 'preset') {
        const presetSelect = document.querySelector('select[name="preset-id"]');
        if (presetSelect) {
          const selectedOption = presetSelect.options[presetSelect.selectedIndex];
          vcpus = parseInt(selectedOption.getAttribute('data-vcpus') || '0');
          ramGB = parseInt(selectedOption.getAttribute('data-ram') || '0');
          diskGB = parseInt(selectedOption.getAttribute('data-disk') || '0');
        }
      } else {
        const vcpusInput = document.querySelector('input[name="vcpus"]');
        const ramInput = document.querySelector('input[name="ram-gb"]');
        const diskInput = document.querySelector('input[name="disk-gb"]');

        vcpus = vcpusInput ? parseInt(vcpusInput.value || '0') : 0;
        ramGB = ramInput ? parseInt(ramInput.value || '0') : 0;
        diskGB = diskInput ? parseInt(diskInput.value || '0') : 0;
      }

      const gpuModelSelect = document.querySelector('select[name="gpu-model"]');
      const gpuModel = gpuModelSelect ? gpuModelSelect.value : '';

      const gpuCountInput = document.querySelector('input[name="gpu-count"]');
      const gpuCount = gpuCountInput ? parseInt(gpuCountInput.value || '0') : 0;

      const ipCheckboxes = document.querySelectorAll('input[name="ip-assignments"]:checked');
      const ipCount = ipCheckboxes.length;

      const capacityTypeRadio = document.querySelector('input[name="capacity-type"]:checked');
      const capacityType = capacityTypeRadio ? capacityTypeRadio.value : 'shared';

      // Calculate costs
      let vcpuCost = vcpus * pricing.vm.vCPUPerMonth;
      let ramCost = ramGB * pricing.vm.ramGBPerMonth;
      let diskCost = diskGB * pricing.vm.systemDiskGBPerMonth;
      const ipCost = ipCount * pricing.vm.publicIPv4PerMonth;
      let gpuCost = 0;

      if (gpuModel && gpuCount > 0) {
        const gpuHourly = pricing.vm.gpuPerHour[gpuModel] || 0;
        gpuCost = gpuCount * gpuHourly * 24 * 30;
      }

      // Apply dedicated capacity multiplier (50% more)
      if (capacityType === 'dedicated') {
        vcpuCost = vcpuCost * 1.5;
        ramCost = ramCost * 1.5;
        diskCost = diskCost * 1.5;
      }

      const total = vcpuCost + ramCost + diskCost + ipCost + gpuCost;

      // Update display
      const costVcpus = document.getElementById('cost-vcpus');
      const costRam = document.getElementById('cost-ram');
      const costDisk = document.getElementById('cost-disk');
      const costIps = document.getElementById('cost-ips');
      const costTotal = document.getElementById('cost-total');

      if (costVcpus) costVcpus.textContent = vcpus + ' x €' + pricing.vm.vCPUPerMonth;
      if (costRam) costRam.textContent = ramGB + ' GB x €' + pricing.vm.ramGBPerMonth;
      if (costDisk) costDisk.textContent = diskGB + ' GB x €' + pricing.vm.systemDiskGBPerMonth;
      if (costIps) costIps.textContent = ipCount + ' x €' + pricing.vm.publicIPv4PerMonth;
      if (costTotal) costTotal.textContent = '€' + total.toFixed(2);

      const gpuRow = document.getElementById('cost-gpu-row');
      const costGpu = document.getElementById('cost-gpu');
      if (gpuModel && gpuCount > 0) {
        if (gpuRow) gpuRow.classList.remove('hidden');
        if (costGpu) costGpu.textContent = gpuCount + 'x ' + gpuModel + ' (€' + gpuCost.toFixed(2) + ')';
      } else {
        if (gpuRow) gpuRow.classList.add('hidden');
      }

      const dedicatedRow = document.getElementById('cost-dedicated-row');
      if (capacityType === 'dedicated') {
        if (dedicatedRow) dedicatedRow.classList.remove('hidden');
      } else {
        if (dedicatedRow) dedicatedRow.classList.add('hidden');
      }
    }

    // Add event listeners for cost updates
    const presetSelect = document.querySelector('select[name="preset-id"]');
    if (presetSelect) {
      presetSelect.addEventListener('change', function() {
        updateCostEstimate();

        // Re-validate host capacity if manual selection is active
        const manualSelection = document.querySelector('input[name="host-selection"][value="manual"]:checked');
        if (manualSelection) {
          validateHostCapacity();
        }
      });
    }

    const gpuCountInput = document.querySelector('input[name="gpu-count"]');
    if (gpuCountInput) {
      gpuCountInput.addEventListener('input', updateCostEstimate);
    }

    const ipCheckboxes = document.querySelectorAll('input[name="ip-assignments"]');
    ipCheckboxes.forEach(function(cb) {
      cb.addEventListener('change', updateCostEstimate);
    });

    // Form submission
    const form = document.getElementById('vm-create-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        // Collect form data
        const formData = new FormData(e.target);
        const vmData = {
          id: 'vm-' + Date.now(),
          createdAt: new Date().toISOString()
        };

        // Build VM object from form data
        formData.forEach(function(value, key) {
          vmData[key] = value;
        });

        console.log('VM Configuration:', vmData);
        alert('VM creation would start here!\n\nIn a real app, this would:\n1. Validate all inputs\n2. Submit to API\n3. Show provisioning progress\n4. Redirect to VM detail page\n\nCheck console for configuration details.');
      });
    }

    // Initialize
    updateRadioStyles();
    updateCostEstimate();
    showStep(1);
  })();
</script>

