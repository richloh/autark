---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import TagBadge from '../../../components/TagBadge.astro';
import data from '../../../data/data.json';
import { calculateVMCost } from '../../../lib/pricing.js';

const vms = data.data.vms || [];
const presets = data.presets.vm || [];
const ips = data.data.ips || [];
const volumes = data.data.volumes || [];

function getVMDetails(vm) {
  const preset = vm.presetId ? presets.find(p => p.id === vm.presetId) : null;

  let vcpus, ramGB;
  if (preset) {
    vcpus = preset.vcpus;
    ramGB = preset.ramGB;
  } else if (vm.custom) {
    vcpus = vm.custom.vcpus;
    ramGB = vm.custom.ramGB;
  }

  const vmIPs = vm.ips?.map(ipId => {
    const ip = ips.find(i => i.id === ipId);
    return ip?.address;
  }).filter(Boolean).join(', ') || 'None';

  const attachedVolCount = vm.attachedVolumes?.length || 0;
  const firewallCount = vm.firewallIds?.length || 0;

  const cost = calculateVMCost(vm, data.pricing, preset);

  return { vcpus, ramGB, vmIPs, attachedVolCount, firewallCount, cost };
}
---

<AutarkLayout
  title="Virtual Machines"
  description="Create and manage VMs across self-hosted and cloud providers."
  currentPath="/infrastructure/vms"
>
  <!-- Actions Bar -->
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <input
        type="search"
        placeholder="Search VMs..."
        class="border border-gray-300 rounded px-4 py-2 text-sm w-64 focus:ring-2 focus:ring-primary focus:border-transparent"
        id="vm-search"
      />
      <select class="border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary">
        <option value="">All Statuses</option>
        <option value="running">Running</option>
        <option value="stopped">Stopped</option>
      </select>
    </div>
    <div class="flex gap-2">
      <a href="/infrastructure/vms/presets" class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
        Presets
      </a>
      <a href="/infrastructure/vms/create" class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
        Create VM
      </a>
    </div>
  </div>

  <!-- VMs Table -->
  <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Name
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Status
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              vCPU / RAM
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Image
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              IPs
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Volumes
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Tags
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Monthly Cost
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          {vms.map(vm => {
            const details = getVMDetails(vm);
            return (
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <a href={`/infrastructure/vms/detail?id=${vm.id}`} class="text-sm font-medium text-primary hover:underline">
                    {vm.name}
                  </a>
                  <div class="text-xs text-gray-500">{vm.id}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <StatusBadge status={vm.status} />
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {details.vcpus} vCPU / {details.ramGB} GB
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {vm.image?.os} {vm.image?.version}
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  {details.vmIPs}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {details.attachedVolCount}
                </td>
                <td class="px-6 py-4">
                  <div class="flex flex-wrap gap-1">
                    {vm.tags?.slice(0, 2).map(tag => (
                      <TagBadge tag={tag} />
                    ))}
                    {vm.tags && vm.tags.length > 2 && (
                      <span class="text-xs text-gray-500">+{vm.tags.length - 2}</span>
                    )}
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  €{details.cost}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <button class="text-primary hover:text-blue-600 mr-3">Edit</button>
                  <button class="text-danger hover:text-red-600">Delete</button>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Summary Footer -->
  <div class="mt-4 flex items-center justify-between text-sm text-gray-600">
    <div>
      Showing {vms.length} VMs
    </div>
    <div>
      Total monthly cost: <span class="font-medium text-gray-900">€{vms.reduce((sum, vm) => {
        const preset = vm.presetId ? presets.find(p => p.id === vm.presetId) : null;
        return sum + calculateVMCost(vm, data.pricing, preset);
      }, 0).toFixed(2)}</span>
    </div>
  </div>
</AutarkLayout>
