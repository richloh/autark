---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
---

<AutarkLayout
  title="Volume Details"
  description="Block volume details"
  currentPath="/infrastructure/volumes"
>
  <div id="loading" class="text-center py-12">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
    <p class="mt-4 text-gray-600">Loading volume details...</p>
  </div>

  <div id="content" class="hidden">
    <div class="mb-6 flex items-center justify-between">
      <a href="/infrastructure/volumes" class="text-sm text-primary hover:underline">← Back to Volumes</a>
      <div class="flex gap-2" id="actions"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-sm font-medium text-gray-500 mb-3">Specifications</h3>
        <div class="space-y-3" id="specs"></div>
      </div>
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-sm font-medium text-gray-500 mb-3">Performance</h3>
        <div class="space-y-3" id="performance"></div>
      </div>
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-sm font-medium text-gray-500 mb-3">Cost & Backup</h3>
        <div class="space-y-3" id="cost"></div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border border-gray-200 mb-6">
      <h3 class="text-lg font-semibold mb-4">Performance Metrics (Last 24 Hours)</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="metrics"></div>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200 mb-6">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold">Snapshots</h3>
      </div>
      <div class="p-6" id="snapshots"></div>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold">Tags</h3>
      </div>
      <div class="p-6">
        <div class="flex flex-wrap gap-2" id="tags"></div>
      </div>
    </div>
  </div>

  <div id="error" class="hidden text-center py-12">
    <div class="text-danger text-4xl mb-4">⚠</div>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">Volume Not Found</h3>
    <p class="text-gray-600 mb-4">The requested volume could not be found.</p>
    <a href="/infrastructure/volumes" class="text-primary hover:underline">← Back to Volumes</a>
  </div>
</AutarkLayout>

<script>
  import dataJson from '../../../data/data.json';

  const urlParams = new URLSearchParams(window.location.search);
  const volId = urlParams.get('id');

  function renderMetricChart(values: number[], color: string): string {
    const max = Math.max(...values);
    return values.map(value => {
      const height = max > 0 ? (value / max) * 100 : 0;
      return `<div class="flex-1 ${color} rounded-t" style="height: ${height}%" title="${value}"></div>`;
    }).join('');
  }

  function loadVolumeData() {
    if (!volId) {
      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('error')?.classList.remove('hidden');
      return;
    }

    const volume = dataJson.data.volumes.find((v: any) => v.id === volId);
    if (!volume) {
      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('error')?.classList.remove('hidden');
      return;
    }

    document.title = `${volume.name} - Autark`;

    // Actions
    document.getElementById('actions')!.innerHTML = `
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">${volume.attachedTo ? 'Detach' : 'Attach'}</button>
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">Expand</button>
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">Create Snapshot</button>
      <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">Edit</button>
      <button class="px-4 py-2 bg-danger text-white rounded text-sm font-medium hover:bg-red-600">Delete</button>
    `;

    // Specs
    const attachedHtml = volume.attachedTo
      ? `<a href="/infrastructure/vms/detail?id=${volume.attachedTo.id}" class="text-sm font-medium text-primary hover:underline">${volume.attachedTo.id}</a>`
      : '<span class="text-sm font-medium text-gray-400">Unattached</span>';

    document.getElementById('specs')!.innerHTML = `
      <div class="flex justify-between"><span class="text-sm text-gray-600">Type</span><span class="text-sm font-medium">${volume.type.toUpperCase()}</span></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Size</span><span class="text-sm font-medium">${volume.sizeGB} GB</span></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Attached To</span>${attachedHtml}</div>
    `;

    // Performance
    document.getElementById('performance')!.innerHTML = `
      <div class="flex justify-between"><span class="text-sm text-gray-600">IOPS</span><span class="text-sm font-medium">${volume.iops}</span></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Throughput</span><span class="text-sm font-medium">${volume.throughputMBps} MB/s</span></div>
    `;

    // Cost
    document.getElementById('cost')!.innerHTML = `
      <div class="flex justify-between"><span class="text-sm text-gray-600">Monthly Cost</span><span class="text-sm font-medium text-gray-900">€${volume.monthlyCostHint}</span></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Backups</span><span class="text-sm font-medium">${volume.backupPolicy?.enabled ? 'Enabled' : 'Disabled'}</span></div>
      ${volume.backupPolicy?.enabled ? `
        <div class="flex justify-between"><span class="text-sm text-gray-600">Schedule</span><span class="text-sm font-medium">${volume.backupPolicy.schedule}</span></div>
        <div class="flex justify-between"><span class="text-sm text-gray-600">Retention</span><span class="text-sm font-medium">${volume.backupPolicy.retention} copies</span></div>
      ` : ''}
    `;

    // Metrics
    const metrics = volume.metrics || {
      iops: [200, 350, 500, 300, 450, 400, 380, 420, 460, 440, 400, 380, 350, 320, 300, 340, 380, 420, 450, 480, 460, 440, 410, 380],
      throughput: [50, 70, 80, 65, 90, 85, 60, 75, 95, 88, 80, 75, 70, 65, 60, 68, 75, 82, 90, 95, 92, 88, 82, 75]
    };

    document.getElementById('metrics')!.innerHTML = `
      <div>
        <h4 class="text-sm font-medium text-gray-700 mb-2">IOPS</h4>
        <div class="h-32 flex items-end gap-1">${renderMetricChart(metrics.iops, 'bg-primary')}</div>
        <div class="mt-2 text-xs text-gray-500 text-center">Hourly samples</div>
      </div>
      <div>
        <h4 class="text-sm font-medium text-gray-700 mb-2">Throughput (MB/s)</h4>
        <div class="h-32 flex items-end gap-1">${renderMetricChart(metrics.throughput, 'bg-accent')}</div>
        <div class="mt-2 text-xs text-gray-500 text-center">Hourly samples</div>
      </div>
    `;

    // Snapshots
    if (volume.snapshots && volume.snapshots.length > 0) {
      document.getElementById('snapshots')!.innerHTML = `
        <div class="space-y-2">
          ${volume.snapshots.map((snap: any) => `
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
              <div>
                <span class="text-sm font-medium">${snap.id}</span>
                <span class="ml-2 text-xs text-gray-500">${new Date(snap.createdAt).toLocaleString()}</span>
              </div>
              <span class="text-sm text-gray-600">${snap.sizeGB} GB</span>
            </div>
          `).join('')}
        </div>
      `;
    } else {
      document.getElementById('snapshots')!.innerHTML = '<p class="text-sm text-gray-500">No snapshots</p>';
    }

    // Tags
    if (volume.tags && volume.tags.length > 0) {
      document.getElementById('tags')!.innerHTML = volume.tags.map((tag: any) => `
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">${tag.key}: ${tag.value}</span>
      `).join('');
    } else {
      document.getElementById('tags')!.innerHTML = '<p class="text-sm text-gray-500">No tags</p>';
    }

    document.getElementById('loading')?.classList.add('hidden');
    document.getElementById('content')?.classList.remove('hidden');
  }

  loadVolumeData();
</script>
