---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import data from '../../../data/data.json';

const presets = data.presets.volume || [];
---

<AutarkLayout
  title="Volume Presets"
  description="Standardize storage configs for repeatable deployments."
  currentPath="/infrastructure/volumes"
>
  <!-- Actions Bar -->
  <div class="mb-6 flex items-center justify-between">
    <a href="/infrastructure/volumes" class="text-sm text-primary hover:underline">
      ← Back to Volumes
    </a>
    <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600" id="add-preset-btn">
      Add Preset
    </button>
  </div>

  <!-- Presets Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {presets.map(preset => (
      <div class="bg-white rounded-lg shadow border border-gray-200 p-6 hover:shadow-lg transition-shadow">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-gray-900">{preset.name}</h3>
            <p class="text-xs text-gray-500 mt-1">{preset.id}</p>
          </div>
          <div class="flex gap-2">
            <button class="text-primary hover:text-blue-600 text-sm" data-action="edit" data-id={preset.id}>
              Edit
            </button>
            <button class="text-danger hover:text-red-600 text-sm" data-action="delete" data-id={preset.id}>
              Delete
            </button>
          </div>
        </div>

        <div class="space-y-3">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <div class="text-xs text-gray-500">Type</div>
              <div class="text-sm font-medium text-gray-900">{preset.type.toUpperCase()}</div>
            </div>
            <div>
              <div class="text-xs text-gray-500">Size</div>
              <div class="text-sm font-medium text-gray-900">{preset.sizeGB} GB</div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <div class="text-xs text-gray-500">IOPS</div>
              <div class="text-sm font-medium text-gray-900">{preset.iops}</div>
            </div>
            <div>
              <div class="text-xs text-gray-500">Throughput</div>
              <div class="text-sm font-medium text-gray-900">{preset.throughputMBps} MB/s</div>
            </div>
          </div>

          <div class="pt-3 border-t border-gray-200">
            <div class="text-xs text-gray-500">Monthly Price</div>
            <div class="text-lg font-bold text-primary">€{preset.monthlyPrice}</div>
          </div>
        </div>
      </div>
    ))}

    <!-- Add New Preset Card -->
    <div class="bg-gray-50 rounded-lg border-2 border-dashed border-gray-300 p-6 flex flex-col items-center justify-center hover:border-primary hover:bg-gray-100 transition-colors cursor-pointer min-h-[280px]" id="add-preset-card">
      <svg class="w-12 h-12 text-gray-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      <span class="text-sm font-medium text-gray-600">Add New Preset</span>
    </div>
  </div>

  <!-- Add/Edit Modal -->
  <div id="preset-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900" id="modal-title">Add Volume Preset</h2>
      </div>

      <form id="preset-form" class="p-6 space-y-6">
        <input type="hidden" id="preset-id" />

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Preset Name</label>
          <input type="text" id="preset-name" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="e.g., SSD-500, NVMe-1TB" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Type</label>
            <select id="preset-type" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent">
              <option value="ssd">SSD</option>
              <option value="nvme">NVMe</option>
              <option value="hdd">HDD</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Size (GB)</label>
            <input type="number" id="preset-size" required min="1" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">IOPS</label>
            <input type="number" id="preset-iops" required min="100" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Throughput (MB/s)</label>
            <input type="number" id="preset-throughput" required min="10" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Monthly Price (€)</label>
          <input type="number" id="preset-price" required min="0" step="0.01" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" />
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-gray-200">
          <button type="button" id="cancel-btn" class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
            Cancel
          </button>
          <button type="submit" class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
            Save Preset
          </button>
        </div>
      </form>
    </div>
  </div>
</AutarkLayout>

<script>
  const modal = document.getElementById('preset-modal');
  const modalTitle = document.getElementById('modal-title');
  const form = document.getElementById('preset-form');
  const addPresetBtn = document.getElementById('add-preset-btn');
  const addPresetCard = document.getElementById('add-preset-card');
  const cancelBtn = document.getElementById('cancel-btn');

  function openModal(preset = null) {
    if (!modal || !modalTitle || !form) return;

    if (preset) {
      modalTitle.textContent = 'Edit Volume Preset';
      (document.getElementById('preset-id') as HTMLInputElement).value = preset.id;
      (document.getElementById('preset-name') as HTMLInputElement).value = preset.name;
      (document.getElementById('preset-type') as HTMLSelectElement).value = preset.type;
      (document.getElementById('preset-size') as HTMLInputElement).value = preset.sizeGB;
      (document.getElementById('preset-iops') as HTMLInputElement).value = preset.iops;
      (document.getElementById('preset-throughput') as HTMLInputElement).value = preset.throughputMBps;
      (document.getElementById('preset-price') as HTMLInputElement).value = preset.monthlyPrice;
    } else {
      modalTitle.textContent = 'Add Volume Preset';
      form.reset();
      (document.getElementById('preset-id') as HTMLInputElement).value = '';
    }

    modal.classList.remove('hidden');
  }

  function closeModal() {
    modal?.classList.add('hidden');
    form?.reset();
  }

  addPresetBtn?.addEventListener('click', () => openModal());
  addPresetCard?.addEventListener('click', () => openModal());
  cancelBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.querySelectorAll('[data-action]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const action = target.getAttribute('data-action');
      const id = target.getAttribute('data-id');

      if (action === 'edit') {
        alert(`Edit preset: ${id}\n\nIn a real app, this would load the preset data into the form.`);
      } else if (action === 'delete') {
        if (confirm(`Are you sure you want to delete this preset?`)) {
          alert(`Delete preset: ${id}\n\nIn a real app, this would remove the preset from localStorage.`);
        }
      }
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const formData = {
      id: (document.getElementById('preset-id') as HTMLInputElement).value || `vol-${Date.now()}`,
      name: (document.getElementById('preset-name') as HTMLInputElement).value,
      type: (document.getElementById('preset-type') as HTMLSelectElement).value,
      sizeGB: parseInt((document.getElementById('preset-size') as HTMLInputElement).value),
      iops: parseInt((document.getElementById('preset-iops') as HTMLInputElement).value),
      throughputMBps: parseInt((document.getElementById('preset-throughput') as HTMLInputElement).value),
      monthlyPrice: parseFloat((document.getElementById('preset-price') as HTMLInputElement).value),
    };

    console.log('Saving preset:', formData);
    alert('Preset saved!\n\nIn a real app, this would save to localStorage and refresh the page.');

    closeModal();
  });
</script>
