---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import TagBadge from '../../../components/TagBadge.astro';
---

<AutarkLayout
  title="DNS Zone Details"
  description="DNS zone records and configuration"
  currentPath="/infrastructure/dns"
>
  <div id="loading" class="text-center py-12">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
    <p class="mt-4 text-gray-600">Loading zone details...</p>
  </div>

  <div id="content" class="hidden">
    <div class="mb-6 flex items-center justify-between">
      <a href="/infrastructure/dns" class="text-sm text-primary hover:underline">← Back to DNS Zones</a>
      <div class="flex gap-2" id="actions"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-sm font-medium text-gray-500 mb-3">Zone Information</h3>
        <div class="space-y-3" id="zone-info"></div>
      </div>
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-sm font-medium text-gray-500 mb-3">Statistics</h3>
        <div class="space-y-3" id="zone-stats"></div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200 mb-6">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-lg font-semibold">DNS Records</h3>
        <button class="px-3 py-1 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
          + Add Record
        </button>
      </div>
      <div class="overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200" id="records-table"></table>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold">Tags</h3>
      </div>
      <div class="p-6">
        <div class="flex flex-wrap gap-2" id="tags"></div>
      </div>
    </div>
  </div>

  <div id="error" class="hidden text-center py-12">
    <div class="text-danger text-4xl mb-4">⚠</div>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">Zone Not Found</h3>
    <p class="text-gray-600 mb-4">The requested DNS zone could not be found.</p>
    <a href="/infrastructure/dns" class="text-primary hover:underline">← Back to DNS Zones</a>
  </div>
</AutarkLayout>

<script>
  import dataJson from '../../../data/data.json';

  const urlParams = new URLSearchParams(window.location.search);
  const zoneId = urlParams.get('id');

  function loadZoneData() {
    if (!zoneId) {
      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('error')?.classList.remove('hidden');
      return;
    }

    const zone = dataJson.data.dnsZones.find((z: any) => z.id === zoneId);
    if (!zone) {
      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('error')?.classList.remove('hidden');
      return;
    }

    document.title = `${zone.name} - Autark`;

    // Actions
    document.getElementById('actions')!.innerHTML = `
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">Export Zone File</button>
      <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">Edit</button>
      <button class="px-4 py-2 bg-danger text-white rounded text-sm font-medium hover:bg-red-600">Delete</button>
    `;

    // Zone Info
    document.getElementById('zone-info')!.innerHTML = `
      <div class="flex justify-between"><span class="text-sm text-gray-600">Zone ID</span><span class="text-sm font-medium font-mono">${zone.id}</span></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Domain</span><span class="text-sm font-medium">${zone.name}</span></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Provider</span><span class="text-sm font-medium">${zone.provider}</span></div>
    `;

    // Stats
    const recordsByType: any = {};
    zone.records?.forEach((record: any) => {
      recordsByType[record.type] = (recordsByType[record.type] || 0) + 1;
    });

    const recordTypeStats = Object.entries(recordsByType)
      .map(([type, count]) => `<span class="text-xs px-2 py-1 rounded bg-gray-100">${type}: ${count}</span>`)
      .join(' ');

    const zoneCost = dataJson.pricing.dns.zonePerMonth + (zone.records?.length || 0) * dataJson.pricing.dns.recordPerMonth;

    document.getElementById('zone-stats')!.innerHTML = `
      <div class="flex justify-between"><span class="text-sm text-gray-600">Total Records</span><span class="text-sm font-medium">${zone.records?.length || 0}</span></div>
      <div class="flex justify-between items-center"><span class="text-sm text-gray-600">Record Types</span><div class="flex gap-1">${recordTypeStats}</div></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Monthly Cost</span><span class="text-sm font-medium">€${zoneCost.toFixed(2)}</span></div>
    `;

    // Records Table
    if (zone.records && zone.records.length > 0) {
      document.getElementById('records-table')!.innerHTML = `
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Value</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">TTL</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          ${zone.records.map((record: any) => {
            const typeColor = record.type === 'A' ? 'bg-blue-100 text-blue-800' :
                            record.type === 'AAAA' ? 'bg-blue-100 text-blue-800' :
                            record.type === 'CNAME' ? 'bg-purple-100 text-purple-800' :
                            record.type === 'MX' ? 'bg-green-100 text-green-800' :
                            record.type === 'TXT' ? 'bg-yellow-100 text-yellow-800' :
                            'bg-gray-100 text-gray-800';

            return `
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${typeColor}">${record.type}</span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-mono">${record.name}</td>
                <td class="px-6 py-4 text-sm font-mono text-xs max-w-md truncate" title="${record.value}">${record.value}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">${record.ttl}s</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <button class="text-primary hover:underline text-xs mr-2">Edit</button>
                  <button class="text-danger hover:underline text-xs">Delete</button>
                </td>
              </tr>
            `;
          }).join('')}
        </tbody>
      `;
    } else {
      document.getElementById('records-table')!.innerHTML = '<tbody><tr><td class="px-6 py-4 text-sm text-gray-500">No DNS records</td></tr></tbody>';
    }

    // Tags
    if (zone.tags && zone.tags.length > 0) {
      document.getElementById('tags')!.innerHTML = zone.tags.map((tag: any) => `
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">${tag.key}: ${tag.value}</span>
      `).join('');
    } else {
      document.getElementById('tags')!.innerHTML = '<p class="text-sm text-gray-500">No tags</p>';
    }

    document.getElementById('loading')?.classList.add('hidden');
    document.getElementById('content')?.classList.remove('hidden');
  }

  loadZoneData();
</script>
