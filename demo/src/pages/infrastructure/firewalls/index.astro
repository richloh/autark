---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import data from '../../../data/data.json';

const firewalls = data.data.firewalls || [];
---

<AutarkLayout
  title="Firewalls"
  description="Define and attach firewall rule sets."
  currentPath="/infrastructure/firewalls"
>
  <div class="mb-6 flex justify-end">
    <a href="/infrastructure/firewalls/create" class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
      Create Firewall
    </a>
  </div>

  <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Default Policy</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Rules</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Attached To</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {firewalls.map(fw => (
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <a href={`/infrastructure/firewalls/detail?id=${fw.id}`} class="text-sm font-medium text-primary hover:underline">{fw.name}</a>
              <div class="text-xs text-gray-500">{fw.id}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">{fw.defaultPolicy}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">{fw.rules?.length || 0}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">{fw.attachedTo?.length || 0} resources</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AutarkLayout>
