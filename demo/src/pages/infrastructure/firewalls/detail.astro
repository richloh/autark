---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import TagBadge from '../../../components/TagBadge.astro';
---

<AutarkLayout
  title="Firewall Details"
  description="Firewall rules and configuration"
  currentPath="/infrastructure/firewalls"
>
  <div id="loading" class="text-center py-12">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
    <p class="mt-4 text-gray-600">Loading firewall details...</p>
  </div>

  <div id="content" class="hidden">
    <div class="mb-6 flex items-center justify-between">
      <a href="/infrastructure/firewalls" class="text-sm text-primary hover:underline">← Back to Firewalls</a>
      <div class="flex gap-2" id="actions"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-sm font-medium text-gray-500 mb-3">Configuration</h3>
        <div class="space-y-3" id="firewall-config"></div>
      </div>
      <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
        <h3 class="text-sm font-medium text-gray-500 mb-3">Statistics</h3>
        <div class="space-y-3" id="firewall-stats"></div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200 mb-6">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-lg font-semibold">Firewall Rules</h3>
        <button class="px-3 py-1 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
          + Add Rule
        </button>
      </div>
      <div class="overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200" id="rules-table"></table>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200 mb-6">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold">Attached Resources</h3>
      </div>
      <div class="p-6" id="attached-resources"></div>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold">Tags</h3>
      </div>
      <div class="p-6">
        <div class="flex flex-wrap gap-2" id="tags"></div>
      </div>
    </div>
  </div>

  <div id="error" class="hidden text-center py-12">
    <div class="text-danger text-4xl mb-4">⚠</div>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">Firewall Not Found</h3>
    <p class="text-gray-600 mb-4">The requested firewall could not be found.</p>
    <a href="/infrastructure/firewalls" class="text-primary hover:underline">← Back to Firewalls</a>
  </div>
</AutarkLayout>

<script>
  import dataJson from '../../../data/data.json';

  const urlParams = new URLSearchParams(window.location.search);
  const fwId = urlParams.get('id');

  function loadFirewallData() {
    if (!fwId) {
      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('error')?.classList.remove('hidden');
      return;
    }

    const firewall = dataJson.data.firewalls.find((f: any) => f.id === fwId);
    if (!firewall) {
      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('error')?.classList.remove('hidden');
      return;
    }

    document.title = `${firewall.name} - Autark`;

    // Actions
    document.getElementById('actions')!.innerHTML = `
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">Clone</button>
      <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">Edit</button>
      <button class="px-4 py-2 bg-danger text-white rounded text-sm font-medium hover:bg-red-600">Delete</button>
    `;

    // Firewall Config
    const policyBadge = firewall.defaultPolicy === 'allow'
      ? '<span class="text-sm font-medium px-2 py-1 rounded bg-green-100 text-green-800">ALLOW</span>'
      : '<span class="text-sm font-medium px-2 py-1 rounded bg-red-100 text-red-800">DENY</span>';

    document.getElementById('firewall-config')!.innerHTML = `
      <div class="flex justify-between"><span class="text-sm text-gray-600">Firewall ID</span><span class="text-sm font-medium font-mono">${firewall.id}</span></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Name</span><span class="text-sm font-medium">${firewall.name}</span></div>
      <div class="flex justify-between items-center"><span class="text-sm text-gray-600">Default Policy</span>${policyBadge}</div>
    `;

    // Stats
    const inboundRules = firewall.rules?.filter((r: any) => r.direction === 'inbound').length || 0;
    const outboundRules = firewall.rules?.filter((r: any) => r.direction === 'outbound').length || 0;
    const allowRules = firewall.rules?.filter((r: any) => r.action === 'allow').length || 0;
    const denyRules = firewall.rules?.filter((r: any) => r.action === 'deny').length || 0;

    document.getElementById('firewall-stats')!.innerHTML = `
      <div class="flex justify-between"><span class="text-sm text-gray-600">Total Rules</span><span class="text-sm font-medium">${firewall.rules?.length || 0}</span></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Inbound / Outbound</span><span class="text-sm font-medium">${inboundRules} / ${outboundRules}</span></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Allow / Deny</span><span class="text-sm font-medium">${allowRules} / ${denyRules}</span></div>
      <div class="flex justify-between"><span class="text-sm text-gray-600">Attached Resources</span><span class="text-sm font-medium">${firewall.attachedTo?.length || 0}</span></div>
    `;

    // Rules Table
    if (firewall.rules && firewall.rules.length > 0) {
      document.getElementById('rules-table')!.innerHTML = `
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Priority</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Direction</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Protocol</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ports</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Source</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          ${firewall.rules.sort((a: any, b: any) => a.priority - b.priority).map((rule: any) => {
            const actionBadge = rule.action === 'allow'
              ? '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">ALLOW</span>'
              : '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">DENY</span>';

            const directionBadge = rule.direction === 'inbound'
              ? '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">↓ Inbound</span>'
              : '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800">↑ Outbound</span>';

            return `
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">${rule.priority}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">${directionBadge}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-mono uppercase">${rule.protocol}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-mono">${rule.ports}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-xs">${rule.source}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">${actionBadge}</td>
              </tr>
            `;
          }).join('')}
        </tbody>
      `;
    } else {
      document.getElementById('rules-table')!.innerHTML = '<tbody><tr><td class="px-6 py-4 text-sm text-gray-500">No rules configured</td></tr></tbody>';
    }

    // Attached Resources
    if (firewall.attachedTo && firewall.attachedTo.length > 0) {
      const vmAttachments = firewall.attachedTo.filter((att: any) => att.type === 'vm');

      if (vmAttachments.length > 0) {
        const vmDetails = vmAttachments.map((att: any) => {
          const vm = dataJson.data.vms.find((v: any) => v.id === att.id);
          return vm ? { ...att, vm } : att;
        });

        document.getElementById('attached-resources')!.innerHTML = `
          <div class="space-y-2">
            <h4 class="text-sm font-medium text-gray-700 mb-3">Virtual Machines (${vmAttachments.length})</h4>
            ${vmDetails.map((att: any) => {
              if (att.vm) {
                return `
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
                    <div>
                      <a href="/infrastructure/vms/detail?id=${att.vm.id}" class="text-sm font-medium text-primary hover:underline">${att.vm.name}</a>
                      <span class="ml-2 text-xs text-gray-500">${att.vm.id}</span>
                    </div>
                    <span class="text-xs px-2 py-1 rounded ${att.vm.state === 'running' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">${att.vm.state}</span>
                  </div>
                `;
              } else {
                return `
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
                    <span class="text-sm text-gray-600">${att.id}</span>
                  </div>
                `;
              }
            }).join('')}
          </div>
        `;
      } else {
        document.getElementById('attached-resources')!.innerHTML = '<p class="text-sm text-gray-500">No resources attached to this firewall</p>';
      }
    } else {
      document.getElementById('attached-resources')!.innerHTML = '<p class="text-sm text-gray-500">No resources attached to this firewall</p>';
    }

    // Tags
    if (firewall.tags && firewall.tags.length > 0) {
      document.getElementById('tags')!.innerHTML = firewall.tags.map((tag: any) => `
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">${tag.key}: ${tag.value}</span>
      `).join('');
    } else {
      document.getElementById('tags')!.innerHTML = '<p class="text-sm text-gray-500">No tags</p>';
    }

    document.getElementById('loading')?.classList.add('hidden');
    document.getElementById('content')?.classList.remove('hidden');
  }

  loadFirewallData();
</script>
