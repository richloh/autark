---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import data from '../../../data/data.json';

const vms = data.data.vms || [];
---

<AutarkLayout
  title="Create Firewall"
  description="Create a new firewall rule set."
  currentPath="/infrastructure/firewalls"
>
  <div class="max-w-5xl mx-auto">
    <div class="mb-6">
      <a href="/infrastructure/firewalls" class="text-sm text-primary hover:underline mb-4 inline-block">
        ← Back to Firewalls
      </a>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-6">Firewall Configuration</h2>

      <form id="firewall-form" class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Firewall Name</label>
          <input type="text" name="name" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="e.g., web-servers" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Default Policy</label>
          <div class="flex gap-4">
            <label class="relative flex cursor-pointer rounded-lg border border-gray-300 bg-white p-4 hover:border-primary flex-1">
              <input type="radio" name="default-policy" value="deny" checked class="sr-only" />
              <div class="flex flex-col flex-1">
                <span class="block text-sm font-medium text-gray-900">Deny All (Recommended)</span>
                <span class="mt-1 text-xs text-gray-500">Block all traffic except explicitly allowed</span>
              </div>
            </label>
            <label class="relative flex cursor-pointer rounded-lg border border-gray-300 bg-white p-4 hover:border-primary flex-1">
              <input type="radio" name="default-policy" value="allow" class="sr-only" />
              <div class="flex flex-col flex-1">
                <span class="block text-sm font-medium text-gray-900">Allow All</span>
                <span class="mt-1 text-xs text-gray-500">Allow all traffic except explicitly denied</span>
              </div>
            </label>
          </div>
        </div>

        <div class="border-t border-gray-200 pt-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-lg font-semibold text-gray-900">Firewall Rules</h3>
              <p class="text-xs text-gray-500 mt-1">Rules are evaluated by priority (lower numbers first)</p>
            </div>
            <button type="button" id="add-rule" class="px-3 py-1 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
              + Add Rule
            </button>
          </div>

          <div id="rules-container" class="space-y-4">
            <!-- Rules will be added here dynamically -->
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Attach to Resources (Optional)</label>
          <div class="space-y-2">
            {vms.map(vm => (
              <label class="flex items-center p-3 border border-gray-200 rounded hover:bg-gray-50">
                <input type="checkbox" name={`attach-${vm.id}`} value={vm.id} class="rounded border-gray-300 text-primary" />
                <span class="ml-3 text-sm">
                  <span class="font-medium">{vm.name}</span>
                  <span class="text-gray-500 ml-2">({vm.id})</span>
                </span>
              </label>
            ))}
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Tags</label>
          <input type="text" name="tags" placeholder="env:prod, tier:security" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-transparent" />
          <p class="mt-1 text-xs text-gray-500">Comma-separated key:value pairs</p>
        </div>

        <div class="flex justify-end gap-3 pt-6 border-t border-gray-200">
          <a href="/infrastructure/firewalls" class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
            Cancel
          </a>
          <button type="submit" class="px-4 py-2 bg-success text-white rounded text-sm font-medium hover:bg-green-600">
            Create Firewall
          </button>
        </div>
      </form>
    </div>
  </div>
</AutarkLayout>

<script>
  (function() {
    let ruleCount = 0;

    function addRule() {
      ruleCount++;
      const container = document.getElementById('rules-container');
      if (!container) return;

      const ruleHtml = `
        <div class="border border-gray-200 rounded p-4 rule-item" data-rule-id="${ruleCount}">
          <div class="flex items-center justify-between mb-3">
            <h4 class="text-sm font-medium text-gray-900">Rule ${ruleCount}</h4>
            <button type="button" class="text-danger text-sm hover:underline remove-rule" data-rule-id="${ruleCount}">Remove</button>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Priority</label>
              <input type="number" name="rule-${ruleCount}-priority" required min="1" max="65535" value="${ruleCount * 100}" class="w-full border border-gray-300 rounded px-2 py-1 text-sm" />
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Direction</label>
              <select name="rule-${ruleCount}-direction" required class="w-full border border-gray-300 rounded px-2 py-1 text-sm">
                <option value="inbound">Inbound</option>
                <option value="outbound">Outbound</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Protocol</label>
              <select name="rule-${ruleCount}-protocol" required class="w-full border border-gray-300 rounded px-2 py-1 text-sm">
                <option value="tcp">TCP</option>
                <option value="udp">UDP</option>
                <option value="icmp">ICMP</option>
                <option value="any">Any</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Ports</label>
              <input type="text" name="rule-${ruleCount}-ports" required placeholder="80,443 or *" class="w-full border border-gray-300 rounded px-2 py-1 text-sm font-mono" />
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Source CIDR</label>
              <input type="text" name="rule-${ruleCount}-source" required placeholder="0.0.0.0/0" class="w-full border border-gray-300 rounded px-2 py-1 text-sm font-mono" />
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1">Action</label>
              <select name="rule-${ruleCount}-action" required class="w-full border border-gray-300 rounded px-2 py-1 text-sm">
                <option value="allow">Allow</option>
                <option value="deny">Deny</option>
              </select>
            </div>
          </div>
        </div>
      `;

      container.insertAdjacentHTML('beforeend', ruleHtml);
      attachRemoveListeners();
    }

    function attachRemoveListeners() {
      document.querySelectorAll('.remove-rule').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          const target = e.target as HTMLButtonElement;
          const ruleId = target.getAttribute('data-rule-id');
          const ruleItem = document.querySelector(`.rule-item[data-rule-id="${ruleId}"]`);
          if (ruleItem) {
            ruleItem.remove();
          }
        });
      });
    }

    // Visual feedback for radio buttons
    document.querySelectorAll('input[name="default-policy"]').forEach(function(radio) {
      radio.addEventListener('change', function() {
        document.querySelectorAll('input[name="default-policy"]').forEach(function(r) {
          const label = r.closest('label');
          if (label) {
            if (r === radio && (r as HTMLInputElement).checked) {
              label.classList.add('border-primary', 'ring-2', 'ring-primary');
            } else {
              label.classList.remove('border-primary', 'ring-2', 'ring-primary');
            }
          }
        });
      });
    });

    // Initialize first radio button as selected
    const firstRadio = document.querySelector('input[name="default-policy"]:checked');
    if (firstRadio) {
      const label = firstRadio.closest('label');
      if (label) {
        label.classList.add('border-primary', 'ring-2', 'ring-primary');
      }
    }

    document.getElementById('add-rule')?.addEventListener('click', addRule);

    document.getElementById('firewall-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      alert('Firewall creation would start here!\\n\\nIn a real app, this would:\\n1. Validate all rules\\n2. Create firewall configuration\\n3. Attach to selected resources\\n4. Redirect to firewall detail page');
    });

    // Add first rule by default
    addRule();
  })();
</script>
