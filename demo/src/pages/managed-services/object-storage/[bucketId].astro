---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import TagBadge from '../../../components/TagBadge.astro';
import data from '../../../data/data.json';

export function getStaticPaths() {
  const buckets = data.data.buckets || [];
  return buckets.map(bucket => ({
    params: { bucketId: bucket.id },
    props: { bucket }
  }));
}

const { bucket } = Astro.props;

const project = data.projects.find(p => p.id === bucket.projectId);
const account = data.accounts.find(a => a.id === bucket.accountId);

// Convert bytes to GB for display
const storageGB = (bucket.bytesUsed / (1024 * 1024 * 1024)).toFixed(2);

// Mock access keys
const mockAccessKeys = [
  { id: 'key-001', name: 'Production App', created: '2025-09-15', lastUsed: '2025-10-25' },
  { id: 'key-002', name: 'Backup Service', created: '2025-10-01', lastUsed: '2025-10-24' }
];

// Mock lifecycle rules
const mockLifecycleRules = [
  { id: 'rule-001', prefix: 'logs/', transitionDays: 30, toClass: 'INFREQUENT_ACCESS', expireDays: 90 },
  { id: 'rule-002', prefix: 'tmp/', transitionDays: null, toClass: null, expireDays: 7 }
];

// Mock usage metrics (last 7 days)
const usageMetrics = {
  storageGB: [10.2, 10.5, 10.8, 11.1, 11.3, 11.5, parseFloat(storageGB)],
  requests: [180, 220, 195, 250, 210, 230, 240]
};
---

<AutarkLayout
  title={bucket.name}
  description={`Object Storage Bucket ${bucket.id}`}
  currentPath={`/managed-services/object-storage/${bucket.id}`}
>
  <!-- Action Bar -->
  <div class="mb-6 flex items-center justify-between">
    <a href="/managed-services/object-storage" class="text-sm text-primary hover:underline">
      ← Back to Object Storage
    </a>
    <div class="flex gap-2">
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
        Create Access Key
      </button>
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
        Rotate Key
      </button>
      <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
        Edit
      </button>
      <button class="px-4 py-2 bg-danger text-white rounded text-sm font-medium hover:bg-red-600">
        Delete
      </button>
    </div>
  </div>

  <!-- Overview Cards -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 mb-3">Configuration</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Region</span>
          <span class="text-sm font-medium">{bucket.region}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Storage Class</span>
          <span class="text-sm font-medium">{bucket.storageClass}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Versioning</span>
          <span class="text-sm font-medium">{bucket.versioning ? 'Enabled' : 'Disabled'}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Encryption</span>
          <span class="text-sm font-medium">{bucket.encryption}</span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 mb-3">Usage (Last 30 days)</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Storage Used</span>
          <span class="text-sm font-medium">{storageGB} GB</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Requests</span>
          <span class="text-sm font-medium">{bucket.requestsLast30d.toLocaleString()}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Egress</span>
          <span class="text-sm font-medium">{bucket.egressGBLast30d} GB</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Public Access</span>
          <span class={`text-sm font-medium ${bucket.publicAccess ? 'text-amber-600' : 'text-green-600'}`}>
            {bucket.publicAccess ? 'Allowed' : 'Blocked'}
          </span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 mb-3">Project & Cost</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Account</span>
          <span class="text-sm font-medium">{account?.name || 'N/A'}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Project</span>
          <span class="text-sm font-medium">{project?.name || 'N/A'}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Access Keys</span>
          <span class="text-sm font-medium">{mockAccessKeys.length}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Monthly Cost</span>
          <span class="text-lg font-bold text-primary">€{bucket.monthlyCostHint}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="bg-white rounded-lg shadow border border-gray-200">
    <div class="border-b border-gray-200">
      <nav class="flex space-x-8 px-6" aria-label="Tabs">
        <button class="tab-button border-b-2 border-primary text-primary py-4 px-1 text-sm font-medium" data-tab="overview">
          Overview
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="policies">
          Policies
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="lifecycle">
          Lifecycle Rules
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="access-keys">
          Access Keys
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="audit">
          Audit Log
        </button>
      </nav>
    </div>

    <!-- Tab Content -->
    <div class="p-6">
      <!-- Overview Tab -->
      <div id="overview-tab" class="tab-content">
        <h3 class="text-lg font-semibold mb-4">Usage Trends (Last 7 days)</h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-2">Storage (GB)</h4>
            <div class="h-48 flex items-end space-x-2">
              {usageMetrics.storageGB.map(val => (
                <div class="flex-1 bg-primary rounded-t relative group" style={`height: ${(val / Math.max(...usageMetrics.storageGB)) * 100}%`} title={`${val.toFixed(2)} GB`}>
                  <span class="absolute -top-6 left-1/2 transform -translate-x-1/2 text-xs text-gray-600 opacity-0 group-hover:opacity-100">{val.toFixed(1)}</span>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-2">Requests (thousands)</h4>
            <div class="h-48 flex items-end space-x-2">
              {usageMetrics.requests.map(val => (
                <div class="flex-1 bg-accent rounded-t relative group" style={`height: ${(val / Math.max(...usageMetrics.requests)) * 100}%`} title={`${val}k requests`}>
                  <span class="absolute -top-6 left-1/2 transform -translate-x-1/2 text-xs text-gray-600 opacity-0 group-hover:opacity-100">{val}k</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div>
          <h4 class="text-sm font-medium text-gray-700 mb-3">Bucket Endpoint</h4>
          <div class="bg-gray-50 border border-gray-200 rounded p-3">
            <p class="font-mono text-sm">s3://{bucket.name}.{bucket.region}.autark.local</p>
            <p class="font-mono text-sm text-gray-600 mt-1">https://{bucket.name}.s3.{bucket.region}.autark.local</p>
          </div>
        </div>

        <div class="mt-6">
          <h4 class="text-sm font-medium text-gray-700 mb-3">Tags</h4>
          <div class="flex flex-wrap gap-2">
            {bucket.tags && bucket.tags.length > 0 ? (
              bucket.tags.map(tag => <TagBadge tag={tag} />)
            ) : (
              <p class="text-sm text-gray-500">No tags</p>
            )}
          </div>
        </div>
      </div>

      <!-- Policies Tab -->
      <div id="policies-tab" class="tab-content hidden">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold">Bucket Policies</h3>
          <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
            Edit Policy
          </button>
        </div>

        <div class="space-y-4">
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-2">Public Access Block</h4>
            <div class="border border-gray-200 rounded p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium">Block all public access</span>
                <span class={`px-2 py-1 rounded text-xs font-medium ${bucket.publicAccess ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700'}`}>
                  {bucket.publicAccess ? 'Disabled' : 'Enabled'}
                </span>
              </div>
              <p class="text-sm text-gray-600">
                {bucket.publicAccess
                  ? 'Public access is currently allowed. Consider blocking for security.'
                  : 'Public access is blocked. Objects are private by default.'}
              </p>
            </div>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-2">CORS Configuration</h4>
            <div class="border border-gray-200 rounded p-4">
              <p class="text-sm text-gray-500">No CORS rules configured</p>
              <button class="mt-2 px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                Add CORS Rule
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Lifecycle Tab -->
      <div id="lifecycle-tab" class="tab-content hidden">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold">Lifecycle Rules</h3>
          <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
            Add Rule
          </button>
        </div>

        {mockLifecycleRules.length > 0 ? (
          <div class="space-y-3">
            {mockLifecycleRules.map(rule => (
              <div class="border border-gray-200 rounded-lg p-4">
                <div class="flex justify-between items-start mb-2">
                  <div>
                    <p class="font-medium text-sm">Rule: {rule.id}</p>
                    <p class="text-sm text-gray-600 mt-1">Prefix: <span class="font-mono">{rule.prefix}</span></p>
                  </div>
                  <div class="flex gap-2">
                    <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                      Edit
                    </button>
                    <button class="px-3 py-1 border border-red-300 text-red-600 rounded text-sm hover:bg-red-50">
                      Delete
                    </button>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-4 text-sm mt-3">
                  {rule.transitionDays && (
                    <div>
                      <span class="text-gray-500">Transition:</span>
                      <span class="ml-2 font-medium">After {rule.transitionDays} days → {rule.toClass}</span>
                    </div>
                  )}
                  {rule.expireDays && (
                    <div>
                      <span class="text-gray-500">Expire:</span>
                      <span class="ml-2 font-medium">After {rule.expireDays} days</span>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-gray-500 text-center py-8">No lifecycle rules configured</p>
        )}
      </div>

      <!-- Access Keys Tab -->
      <div id="access-keys-tab" class="tab-content hidden">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold">Access Keys</h3>
          <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
            Create Access Key
          </button>
        </div>

        <div class="space-y-3">
          {mockAccessKeys.map(key => (
            <div class="border border-gray-200 rounded-lg p-4">
              <div class="flex justify-between items-start">
                <div>
                  <p class="font-medium">{key.name}</p>
                  <p class="text-sm text-gray-500 mt-1">Key ID: {key.id}</p>
                  <div class="flex gap-4 mt-2 text-xs text-gray-600">
                    <span>Created: {key.created}</span>
                    <span>Last used: {key.lastUsed}</span>
                  </div>
                </div>
                <div class="flex gap-2">
                  <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                    Rotate
                  </button>
                  <button class="px-3 py-1 border border-red-300 text-red-600 rounded text-sm hover:bg-red-50">
                    Revoke
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-6 p-4 bg-amber-50 border border-amber-200 rounded">
          <p class="text-sm text-amber-800">
            <strong>Security Note:</strong> Store access keys securely. They provide full access to this bucket.
          </p>
        </div>
      </div>

      <!-- Audit Tab -->
      <div id="audit-tab" class="tab-content hidden">
        <h3 class="text-lg font-semibold mb-4">Audit Log</h3>
        <div class="space-y-2">
          <div class="text-sm border-l-2 border-blue-500 pl-4 py-2">
            <p class="font-medium">Bucket created</p>
            <p class="text-gray-500">admin@example.com - 2025-09-01 10:00:00</p>
          </div>
          <div class="text-sm border-l-2 border-green-500 pl-4 py-2">
            <p class="font-medium">Access key created: {mockAccessKeys[0].name}</p>
            <p class="text-gray-500">admin@example.com - 2025-09-15 14:20:00</p>
          </div>
          <div class="text-sm border-l-2 border-blue-500 pl-4 py-2">
            <p class="font-medium">Lifecycle rule added for logs/</p>
            <p class="text-gray-500">ops@example.com - 2025-09-20 09:30:00</p>
          </div>
          <div class="text-sm border-l-2 border-green-500 pl-4 py-2">
            <p class="font-medium">Access key created: {mockAccessKeys[1].name}</p>
            <p class="text-gray-500">admin@example.com - 2025-10-01 11:15:00</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</AutarkLayout>

<script>
  // Tab switching
  const tabButtons = document.querySelectorAll('.tab-button');
  const tabContents = document.querySelectorAll('.tab-content');

  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tabName = button.getAttribute('data-tab');

      // Remove active state from all buttons
      tabButtons.forEach(btn => {
        btn.classList.remove('border-primary', 'text-primary');
        btn.classList.add('border-transparent', 'text-gray-500');
      });

      // Add active state to clicked button
      button.classList.remove('border-transparent', 'text-gray-500');
      button.classList.add('border-primary', 'text-primary');

      // Hide all tab contents
      tabContents.forEach(content => {
        content.classList.add('hidden');
      });

      // Show selected tab content
      document.getElementById(`${tabName}-tab`)?.classList.remove('hidden');
    });
  });
</script>
