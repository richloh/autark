---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import data from '../../../data/data.json';
import { calculateK8sCost } from '../../../lib/pricing.js';

const clusters = data.data.kubernetes || [];
---

<AutarkLayout
  title="Kubernetes"
  description="Managed Kubernetes clusters."
  currentPath="/managed-services/kubernetes"
>
  <div class="mb-6 flex justify-end">
    <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
      Create Cluster
    </button>
  </div>

  <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Version</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Control Plane</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Node Pools</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Monthly Cost</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {clusters.map(cluster => (
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-primary">{cluster.name}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">{cluster.version}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              {cluster.controlPlane?.size} {cluster.controlPlane?.ha && '(HA)'}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">{cluster.nodePools?.length || 0}</td>
            <td class="px-6 py-4 whitespace-nowrap">
              <StatusBadge status={cluster.status} />
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              €{calculateK8sCost(cluster, data.pricing, data.presets.k8sNode)}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AutarkLayout>
