---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import TagBadge from '../../../components/TagBadge.astro';
import data from '../../../data/data.json';

export function getStaticPaths() {
  const clusters = data.data.kubernetes || [];
  return clusters.map(cluster => ({
    params: { id: cluster.id },
    props: { cluster }
  }));
}

const { cluster } = Astro.props;

const network = data.data.networks.find(n => n.id === cluster.networkId);
const project = data.projects.find(p => p.id === cluster.projectId);

// Calculate total nodes
const totalNodes = cluster.nodePools.reduce((sum, pool) => sum + pool.count, 0);

// Mock metrics
const metrics = {
  apiLatencyMs: [20, 18, 22, 19, 17, 21, 20, 23, 19, 18],
  podCount: [45, 47, 48, 50, 52, 51, 49, 48, 50, 52],
  nodeUtilization: [54, 56, 58, 60, 62, 61, 59, 57, 58, 60]
};

// Mock workloads data
const mockWorkloads = {
  deployments: 12,
  statefulSets: 3,
  daemonSets: 5,
  services: 15,
  ingresses: 4,
  configMaps: 23,
  secrets: 18
};
---

<AutarkLayout
  title={cluster.name}
  description={`Kubernetes Cluster ${cluster.id}`}
  currentPath={`/managed-services/kubernetes/${cluster.id}`}
>
  <!-- Action Bar -->
  <div class="mb-6 flex items-center justify-between">
    <a href="/managed-services/kubernetes" class="text-sm text-primary hover:underline">
      ← Back to Kubernetes
    </a>
    <div class="flex gap-2">
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
        Scale Node Pool
      </button>
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
        Rotate Certificates
      </button>
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
        Download kubeconfig
      </button>
      <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
        Edit
      </button>
      <button class="px-4 py-2 bg-danger text-white rounded text-sm font-medium hover:bg-red-600">
        Delete
      </button>
    </div>
  </div>

  <!-- Overview Cards -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 mb-3">Cluster Info</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Status</span>
          <StatusBadge status={cluster.status} />
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Version</span>
          <span class="text-sm font-medium">{cluster.version}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Control Plane</span>
          <span class="text-sm font-medium">{cluster.controlPlane.ha ? 'HA' : 'Single'} ({cluster.controlPlane.size})</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">CNI</span>
          <span class="text-sm font-medium capitalize">{cluster.cni}</span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 mb-3">Resources</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Node Pools</span>
          <span class="text-sm font-medium">{cluster.nodePools.length}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Total Nodes</span>
          <span class="text-sm font-medium">{totalNodes}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Network</span>
          <a href={`/infrastructure/networks/${network?.id}`} class="text-sm font-medium text-primary hover:underline">
            {network?.name || 'N/A'}
          </a>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Storage Class</span>
          <span class="text-sm font-medium">{cluster.storageClass}</span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 mb-3">Add-ons & Cost</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Ingress</span>
          <span class="text-sm font-medium">{cluster.addons.ingress ? 'Enabled' : 'Disabled'}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Metrics Server</span>
          <span class="text-sm font-medium">{cluster.addons.metricsServer ? 'Enabled' : 'Disabled'}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Project</span>
          <span class="text-sm font-medium">{project?.name || 'N/A'}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Monthly Cost</span>
          <span class="text-lg font-bold text-primary">€{cluster.monthlyCostHint}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="bg-white rounded-lg shadow border border-gray-200">
    <div class="border-b border-gray-200">
      <nav class="flex space-x-8 px-6" aria-label="Tabs">
        <button class="tab-button border-b-2 border-primary text-primary py-4 px-1 text-sm font-medium" data-tab="overview">
          Overview
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="nodes">
          Nodes ({totalNodes})
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="workloads">
          Workloads
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="metrics">
          Metrics
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="access">
          Access
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="audit">
          Audit Log
        </button>
      </nav>
    </div>

    <!-- Tab Content -->
    <div class="p-6">
      <!-- Overview Tab -->
      <div id="overview-tab" class="tab-content">
        <h3 class="text-lg font-semibold mb-4">Cluster Overview</h3>

        <div class="space-y-6">
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">Node Pools</h4>
            <div class="space-y-3">
              {cluster.nodePools.map(pool => {
                const preset = data.presets.k8sNode.find(p => p.id === pool.presetId);
                return (
                  <div class="border border-gray-200 rounded-lg p-4">
                    <div class="flex justify-between items-start">
                      <div>
                        <p class="font-medium">{pool.name}</p>
                        {preset && (
                          <p class="text-sm text-gray-500 mt-1">
                            {preset.vcpus} vCPUs • {preset.ramGB} GB RAM • {preset.systemDiskGB} GB Disk
                          </p>
                        )}
                      </div>
                      <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                        {pool.count} nodes
                      </span>
                    </div>
                    {pool.tags && pool.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2 mt-3">
                        {pool.tags.map(tag => <TagBadge tag={tag} />)}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">Tags</h4>
            <div class="flex flex-wrap gap-2">
              {cluster.tags && cluster.tags.length > 0 ? (
                cluster.tags.map(tag => <TagBadge tag={tag} />)
              ) : (
                <p class="text-sm text-gray-500">No tags</p>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Nodes Tab -->
      <div id="nodes-tab" class="tab-content hidden">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold">Node Pools</h3>
          <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
            Add Node Pool
          </button>
        </div>

        <div class="space-y-4">
          {cluster.nodePools.map((pool, idx) => {
            const preset = data.presets.k8sNode.find(p => p.id === pool.presetId);
            return (
              <div class="border border-gray-200 rounded-lg p-4">
                <div class="flex justify-between items-start mb-3">
                  <div>
                    <h4 class="font-medium">{pool.name}</h4>
                    <p class="text-sm text-gray-500">Pool ID: {pool.id}</p>
                  </div>
                  <div class="flex gap-2">
                    <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                      Scale
                    </button>
                    <button class="px-3 py-1 border border-red-300 text-red-600 rounded text-sm hover:bg-red-50">
                      Remove
                    </button>
                  </div>
                </div>

                {preset && (
                  <div class="grid grid-cols-4 gap-4 text-sm">
                    <div>
                      <span class="text-gray-500">Nodes:</span>
                      <span class="ml-2 font-medium">{pool.count}</span>
                    </div>
                    <div>
                      <span class="text-gray-500">vCPUs:</span>
                      <span class="ml-2 font-medium">{preset.vcpus}</span>
                    </div>
                    <div>
                      <span class="text-gray-500">RAM:</span>
                      <span class="ml-2 font-medium">{preset.ramGB} GB</span>
                    </div>
                    <div>
                      <span class="text-gray-500">Disk:</span>
                      <span class="ml-2 font-medium">{preset.systemDiskGB} GB</span>
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>

      <!-- Workloads Tab -->
      <div id="workloads-tab" class="tab-content hidden">
        <h3 class="text-lg font-semibold mb-4">Workloads Summary</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="border border-gray-200 rounded-lg p-4">
            <p class="text-sm text-gray-500">Deployments</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{mockWorkloads.deployments}</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <p class="text-sm text-gray-500">StatefulSets</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{mockWorkloads.statefulSets}</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <p class="text-sm text-gray-500">DaemonSets</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{mockWorkloads.daemonSets}</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <p class="text-sm text-gray-500">Services</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{mockWorkloads.services}</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <p class="text-sm text-gray-500">Ingresses</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{mockWorkloads.ingresses}</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <p class="text-sm text-gray-500">ConfigMaps</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{mockWorkloads.configMaps}</p>
          </div>
          <div class="border border-gray-200 rounded-lg p-4">
            <p class="text-sm text-gray-500">Secrets</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{mockWorkloads.secrets}</p>
          </div>
        </div>
        <p class="text-sm text-gray-500 mt-4">Use kubectl to manage workloads directly.</p>
      </div>

      <!-- Metrics Tab -->
      <div id="metrics-tab" class="tab-content hidden">
        <h3 class="text-lg font-semibold mb-4">Cluster Metrics (Last 24 hours)</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-2">API Latency (ms)</h4>
            <div class="h-48 flex items-end space-x-2">
              {metrics.apiLatencyMs.map(val => (
                <div class="flex-1 bg-primary rounded-t relative group" style={`height: ${(val / Math.max(...metrics.apiLatencyMs)) * 100}%`} title={`${val} ms`}>
                  <span class="absolute -top-6 left-1/2 transform -translate-x-1/2 text-xs text-gray-600 opacity-0 group-hover:opacity-100">{val}</span>
                </div>
              ))}
            </div>
            <p class="text-xs text-gray-500 mt-2 text-center">Average: {Math.round(metrics.apiLatencyMs.reduce((a,b) => a+b, 0) / metrics.apiLatencyMs.length)} ms</p>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-2">Pod Count</h4>
            <div class="h-48 flex items-end space-x-2">
              {metrics.podCount.map(val => (
                <div class="flex-1 bg-accent rounded-t relative group" style={`height: ${(val / Math.max(...metrics.podCount)) * 100}%`} title={`${val} pods`}>
                  <span class="absolute -top-6 left-1/2 transform -translate-x-1/2 text-xs text-gray-600 opacity-0 group-hover:opacity-100">{val}</span>
                </div>
              ))}
            </div>
            <p class="text-xs text-gray-500 mt-2 text-center">Average: {Math.round(metrics.podCount.reduce((a,b) => a+b, 0) / metrics.podCount.length)} pods</p>
          </div>
        </div>
      </div>

      <!-- Access Tab -->
      <div id="access-tab" class="tab-content hidden">
        <h3 class="text-lg font-semibold mb-4">Cluster Access</h3>

        <div class="space-y-4">
          <div>
            <div class="flex justify-between items-center mb-2">
              <h4 class="text-sm font-medium text-gray-700">Kubeconfig</h4>
              <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                Download
              </button>
            </div>
            <pre class="bg-gray-50 border border-gray-200 rounded p-4 text-xs overflow-x-auto">{cluster.kubeconfig}</pre>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-2">API Endpoint</h4>
            <p class="text-sm font-mono bg-gray-50 border border-gray-200 rounded p-3">
              https://{cluster.id}.k8s.autark.local:6443
            </p>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-2">Certificate Rotation</h4>
            <p class="text-sm text-gray-600 mb-2">Last rotated: 2025-10-01</p>
            <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
              Rotate Certificates
            </button>
          </div>
        </div>
      </div>

      <!-- Audit Tab -->
      <div id="audit-tab" class="tab-content hidden">
        <h3 class="text-lg font-semibold mb-4">Audit Log</h3>
        <div class="space-y-2">
          <div class="text-sm border-l-2 border-blue-500 pl-4 py-2">
            <p class="font-medium">Cluster created</p>
            <p class="text-gray-500">System - 2025-10-15 10:00:00</p>
          </div>
          <div class="text-sm border-l-2 border-green-500 pl-4 py-2">
            <p class="font-medium">Node pool scaled to {cluster.nodePools[0]?.count || 3} nodes</p>
            <p class="text-gray-500">admin@example.com - 2025-10-20 14:30:00</p>
          </div>
          <div class="text-sm border-l-2 border-amber-500 pl-4 py-2">
            <p class="font-medium">Certificates rotated</p>
            <p class="text-gray-500">System - 2025-10-22 02:00:00</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</AutarkLayout>

<script>
  // Tab switching
  const tabButtons = document.querySelectorAll('.tab-button');
  const tabContents = document.querySelectorAll('.tab-content');

  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tabName = button.getAttribute('data-tab');

      // Remove active state from all buttons
      tabButtons.forEach(btn => {
        btn.classList.remove('border-primary', 'text-primary');
        btn.classList.add('border-transparent', 'text-gray-500');
      });

      // Add active state to clicked button
      button.classList.remove('border-transparent', 'text-gray-500');
      button.classList.add('border-primary', 'text-primary');

      // Hide all tab contents
      tabContents.forEach(content => {
        content.classList.add('hidden');
      });

      // Show selected tab content
      document.getElementById(`${tabName}-tab`)?.classList.remove('hidden');
    });
  });
</script>
