---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import data from '../../../data/data.json';

const systemAccounts = data.data.systemAccounts || [];
---

<AutarkLayout
  title="System Accounts"
  description="Non-human service identities."
  currentPath="/iam/system-accounts"
>
  <div class="mb-6 flex justify-end">
    <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
      Create System Account
    </button>
  </div>

  <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Scopes</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Keys</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Used</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {systemAccounts.map(svc => (
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-primary">{svc.name}</td>
            <td class="px-6 py-4 text-sm">
              {svc.scopes?.services?.join(', ')}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">{svc.keys?.length || 0}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              {svc.keys?.[0]?.lastUsed && new Date(svc.keys[0].lastUsed).toLocaleString()}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AutarkLayout>
