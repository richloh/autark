---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import data from '../../../data/data.json';

export function getStaticPaths() {
  const systemAccounts = data.data.systemAccounts || [];
  return systemAccounts.map(account => ({
    params: { id: account.id },
    props: { account }
  }));
}

const { account } = Astro.props;

// Get scoped projects
const scopedProjects = account.scopes.projects?.map(projId => {
  const project = data.projects.find(p => p.id === projId);
  return project;
}).filter(Boolean) || [];

// Mock activity log
const activityLog = [
  { action: 'API Request', endpoint: '/api/v1/vms', method: 'GET', timestamp: '2025-10-25 08:00:00', result: 'success' },
  { action: 'API Request', endpoint: '/api/v1/volumes', method: 'POST', timestamp: '2025-10-24 14:30:00', result: 'success' },
  { action: 'API Request', endpoint: '/api/v1/vms/vm-001', method: 'PATCH', timestamp: '2025-10-23 10:15:00', result: 'success' },
  { action: 'Key Rotated', endpoint: '-', method: '-', timestamp: '2025-10-01 09:00:00', result: 'success' },
  { action: 'API Request', endpoint: '/api/v1/buckets', method: 'GET', timestamp: '2025-09-30 16:45:00', result: 'success' }
];
---

<AutarkLayout
  title={account.name}
  description={`System Account ${account.id}`}
  currentPath={`/iam/system-accounts/${account.id}`}
>
  <!-- Action Bar -->
  <div class="mb-6 flex items-center justify-between">
    <a href="/iam/system-accounts" class="text-sm text-primary hover:underline">
      ← Back to System Accounts
    </a>
    <div class="flex gap-2">
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
        Generate Key
      </button>
      <button class="px-4 py-2 border border-gray-300 rounded text-sm font-medium hover:bg-gray-50">
        Revoke Key
      </button>
      <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
        Edit
      </button>
      <button class="px-4 py-2 bg-danger text-white rounded text-sm font-medium hover:bg-red-600">
        Delete
      </button>
    </div>
  </div>

  <!-- Overview Cards -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 mb-3">Account Info</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Name</span>
          <span class="text-sm font-medium">{account.name}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Account ID</span>
          <span class="text-sm font-mono font-medium">{account.id}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Active Keys</span>
          <span class="text-sm font-medium">{account.keys.length}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Status</span>
          <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-medium">
            Active
          </span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 mb-3">Scopes</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Projects</span>
          <span class="text-sm font-medium">{scopedProjects.length}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Services</span>
          <span class="text-sm font-medium">{account.scopes.services.length}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">IP Restrictions</span>
          <span class="text-sm font-medium">{account.ipAllowlist?.length || 0}</span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <h3 class="text-sm font-medium text-gray-500 mb-3">Usage</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Last Used</span>
          <span class="text-sm font-medium">{account.keys[0]?.lastUsed || 'Never'}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">API Calls (Today)</span>
          <span class="text-sm font-medium">847</span>
        </div>
        <div class="flex justify-between">
          <span class="text-sm text-gray-600">Created</span>
          <span class="text-sm font-medium">{account.keys[0]?.createdAt.split('T')[0]}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="bg-white rounded-lg shadow border border-gray-200">
    <div class="border-b border-gray-200">
      <nav class="flex space-x-8 px-6" aria-label="Tabs">
        <button class="tab-button border-b-2 border-primary text-primary py-4 px-1 text-sm font-medium" data-tab="overview">
          Overview
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="keys">
          Keys ({account.keys.length})
        </button>
        <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 py-4 px-1 text-sm font-medium" data-tab="audit">
          Audit Log
        </button>
      </nav>
    </div>

    <!-- Tab Content -->
    <div class="p-6">
      <!-- Overview Tab -->
      <div id="overview-tab" class="tab-content">
        <h3 class="text-lg font-semibold mb-4">System Account Details</h3>

        <div class="space-y-6">
          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">Scoped Projects</h4>
            <div class="space-y-2">
              {scopedProjects.map(project => {
                const account = data.accounts.find(a => a.id === project.accountId);
                return (
                  <div class="border border-gray-200 rounded-lg p-3">
                    <p class="text-sm font-medium">{project.name}</p>
                    <p class="text-xs text-gray-500 mt-1">Account: {account?.name || 'N/A'}</p>
                  </div>
                );
              })}
            </div>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">Allowed Services</h4>
            <div class="flex flex-wrap gap-2">
              {account.scopes.services.map(service => (
                <span class="px-3 py-1 bg-blue-50 text-blue-700 rounded text-sm font-medium capitalize">
                  {service}
                </span>
              ))}
            </div>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">IP Allowlist</h4>
            {account.ipAllowlist && account.ipAllowlist.length > 0 ? (
              <div class="space-y-2">
                {account.ipAllowlist.map(cidr => (
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
                    <span class="text-sm font-mono font-medium">{cidr}</span>
                    <button class="px-3 py-1 border border-red-300 text-red-600 rounded text-sm hover:bg-red-50">
                      Remove
                    </button>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-sm text-gray-500">No IP restrictions (all IPs allowed)</p>
            )}
            <button class="mt-3 px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
              Add CIDR
            </button>
          </div>

          <div>
            <h4 class="text-sm font-medium text-gray-700 mb-3">Recent Activity</h4>
            <div class="space-y-2">
              {activityLog.slice(0, 5).map(activity => (
                <div class="border-l-2 border-green-500 pl-4 py-2">
                  <div class="flex justify-between items-start">
                    <div>
                      <p class="text-sm font-medium">{activity.action}</p>
                      {activity.endpoint !== '-' && (
                        <p class="text-sm text-gray-600 mt-1">
                          <span class="font-mono text-xs">{activity.method} {activity.endpoint}</span>
                        </p>
                      )}
                    </div>
                    <span class={`px-2 py-1 rounded text-xs font-medium ${activity.result === 'success' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
                      {activity.result}
                    </span>
                  </div>
                  <p class="text-xs text-gray-500 mt-1">{activity.timestamp}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Keys Tab -->
      <div id="keys-tab" class="tab-content hidden">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold">API Keys</h3>
          <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
            Generate New Key
          </button>
        </div>

        <div class="space-y-3">
          {account.keys.map((key, idx) => (
            <div class="border border-gray-200 rounded-lg p-4">
              <div class="flex justify-between items-start">
                <div>
                  <div class="flex items-center gap-3">
                    <p class="font-medium">Key {idx + 1}</p>
                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-medium">
                      Active
                    </span>
                  </div>
                  <p class="text-sm text-gray-500 mt-2">Key ID: {key.id}</p>
                  <div class="flex gap-4 mt-2 text-xs text-gray-600">
                    <span>Created: {key.createdAt.split('T')[0]}</span>
                    <span>Last used: {key.lastUsed.split('T')[0]}</span>
                  </div>
                  <div class="mt-3 p-3 bg-gray-50 rounded">
                    <p class="text-xs text-gray-500 mb-1">Access Key</p>
                    <p class="text-sm font-mono">ak_{key.id}_*********************</p>
                  </div>
                </div>
                <div class="flex gap-2">
                  <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                    Rotate
                  </button>
                  <button class="px-3 py-1 border border-red-300 text-red-600 rounded text-sm hover:bg-red-50">
                    Revoke
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-6 p-4 bg-amber-50 border border-amber-200 rounded">
          <p class="text-sm text-amber-800">
            <strong>Security Note:</strong> API keys provide programmatic access to your account. Keep them secure and rotate them regularly. Keys are only shown once upon creation.
          </p>
        </div>
      </div>

      <!-- Audit Tab -->
      <div id="audit-tab" class="tab-content hidden">
        <h3 class="text-lg font-semibold mb-4">Audit Log</h3>
        <div class="space-y-2">
          <div class="text-sm border-l-2 border-blue-500 pl-4 py-2">
            <p class="font-medium">System account created</p>
            <p class="text-gray-500">admin@example.com - 2025-09-15 10:00:00</p>
          </div>
          <div class="text-sm border-l-2 border-green-500 pl-4 py-2">
            <p class="font-medium">API key generated: {account.keys[0]?.id}</p>
            <p class="text-gray-500">admin@example.com - 2025-09-15 10:05:00</p>
          </div>
          <div class="text-sm border-l-2 border-blue-500 pl-4 py-2">
            <p class="font-medium">Scopes configured</p>
            <p class="text-gray-500">admin@example.com - 2025-09-15 10:10:00</p>
          </div>
          {activityLog.slice(0, 3).map(activity => (
            <div class="text-sm border-l-2 border-green-500 pl-4 py-2">
              <p class="font-medium">{activity.action}</p>
              <p class="text-gray-500">{account.name} - {activity.timestamp}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</AutarkLayout>

<script>
  // Tab switching
  const tabButtons = document.querySelectorAll('.tab-button');
  const tabContents = document.querySelectorAll('.tab-content');

  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tabName = button.getAttribute('data-tab');

      // Remove active state from all buttons
      tabButtons.forEach(btn => {
        btn.classList.remove('border-primary', 'text-primary');
        btn.classList.add('border-transparent', 'text-gray-500');
      });

      // Add active state to clicked button
      button.classList.remove('border-transparent', 'text-gray-500');
      button.classList.add('border-primary', 'text-primary');

      // Hide all tab contents
      tabContents.forEach(content => {
        content.classList.add('hidden');
      });

      // Show selected tab content
      document.getElementById(`${tabName}-tab`)?.classList.remove('hidden');
    });
  });
</script>
