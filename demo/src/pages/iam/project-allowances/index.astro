---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import data from '../../../data/data.json';

const allowances = data.data.projectAllowances || [];
---

<AutarkLayout
  title="Project Allowances"
  description="Budgets, quotas, and policy constraints per project."
  currentPath="/iam/project-allowances"
>
  <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Project</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Monthly Budget</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Quotas</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Allowed Services</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Regions</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {allowances.map(allow => {
          const project = data.projects.find(p => p.id === allow.projectId);
          const quotaCount = allow.quotas ? Object.keys(allow.quotas).length : 0;
          return (
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-primary">
                {project?.name || allow.projectId}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">€{allow.budgetMonthly}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">{quotaCount} resources</td>
              <td class="px-6 py-4 text-sm">{allow.allowedServices?.length || 0} services</td>
              <td class="px-6 py-4 text-sm">{allow.regionRestrictions?.join(', ')}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <button class="text-primary hover:text-blue-600">Edit</button>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</AutarkLayout>
