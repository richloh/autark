---
import AutarkLayout from '../../../layouts/AutarkLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import data from '../../../data/data.json';

const users = data.data.users || [];
---

<AutarkLayout
  title="User Accounts"
  description="Manage human user access."
  currentPath="/iam/users"
>
  <div class="mb-6 flex items-center justify-between">
    <input
      type="search"
      placeholder="Search users..."
      class="border border-gray-300 rounded px-4 py-2 text-sm w-64"
    />
    <button class="px-4 py-2 bg-primary text-white rounded text-sm font-medium hover:bg-blue-600">
      Invite User
    </button>
  </div>

  <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Roles</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">MFA</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Login</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {users.map(user => (
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900">{user.name}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">{user.email}</td>
            <td class="px-6 py-4 text-sm">
              {user.roles.map(roleId => {
                const role = data.data.roles.find(r => r.id === roleId);
                return role?.name || roleId;
              }).join(', ')}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              {user.mfa ? '✓' : '—'}
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <StatusBadge status={user.status} />
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              {new Date(user.lastLogin).toLocaleString()}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <button class="text-primary hover:text-blue-600">Edit</button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AutarkLayout>
